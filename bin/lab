#!/usr/bin/env bash
# Assisted Linux Labs — CLI grezza da terminale.
set -euo pipefail

if [ -z "${LAB_ROOT:-}" ]; then
  if [ -d "/opt/assisted-labs/labs" ]; then
    ROOT="/opt/assisted-labs"
  else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
  fi
else
  ROOT="$LAB_ROOT"
fi
LABS="$ROOT/labs"
NORMAL_STATE_DIR="/workspace/training/.lab-state"
HARDCADE_STATE_DIR="/workspace/training/.hardcade-state"
if [ -f "$HARDCADE_STATE_DIR/active" ]; then
  STATE_DIR="$HARDCADE_STATE_DIR"
  TRAINING_ROOT="/workspace/hardcade-training"
else
  STATE_DIR="$NORMAL_STATE_DIR"
  TRAINING_ROOT="/workspace/training"
fi
export LAB_TRAINING_ROOT="$TRAINING_ROOT"
VERSION="2.2"

# ---------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------
hr()   { printf '%s\n' "----------------------------------------"; }
hdr()  { printf '\n'; hr; printf ' %s\n' "$*"; hr; }
die()  { printf 'ERR: %s\n' "$*" >&2; exit 2; }
ok()   { printf 'OK:  %s\n' "$*"; }
warn() { printf '!!   %s\n' "$*" >&2; }
cmd()  { printf '\033[1;36m%s\033[0m' "$*"; }

# Stampa una riga a 2 colonne: la prima (anche con codici colore ANSI) viene
# allineata a W celle VISIBILI. I codici \033[...m NON contano nella larghezza,
# cosi le colonne restano dritte anche se la cella e colorata.
two_col() {
  local W="$1" left="$2" desc="$3" n pad
  n=$(printf '%s' "$left" | sed -e 's/\x1b\[[0-9;]*m//g' | wc -m)
  pad=$((W - n))
  [ "$pad" -lt 1 ] && pad=1
  printf '  %s%*s %s\n' "$left" "$pad" "" "$desc"
}

# Larghezza di display (colonne terminale) di una stringa. Conta 2 per i
# caratteri "wide" (trattini lunghi, CJK, emoji), 1 per il resto. Cosi la
# cornice resta allineata anche se il testo contiene un em-dash.
disp_w() {
  local s="$1" i ch code w=0
  for (( i = 0; i < ${#s}; i++ )); do
    ch="${s:i:1}"
    code=$(printf '%d' "'$ch")
    if  (( code == 0x2013 || code == 0x2014 || code == 0x2015 )) \
     || (( (code >= 0x1100 && code <= 0x115F)   \
        || (code >= 0x2E80 && code <= 0xA4CF)   \
        || (code >= 0xAC00 && code <= 0xD7A3)   \
        || (code >= 0xF900 && code <= 0xFAFF)   \
        || (code >= 0xFE30 && code <= 0xFE6F)   \
        || (code >= 0xFF00 && code <= 0xFF60)   \
        || (code >= 0xFFE0 && code <= 0xFFE6)   \
        || (code >= 0x1F300 && code <= 0x1F64F) \
        || (code >= 0x1F900 && code <= 0x1F9FF) )); then
      w=$((w + 2))
    else
      w=$((w + 1))
    fi
  done
  printf '%s' "$w"
}

# Box "biglietto da visita" con larghezza interna fissa, coerente col banner.
# Default: box ASCII puro (+, -, |) che si renderizza ovunque. Il box Unicode
# (╔═╗║╚╝) si riattiva forzando ASSISTED_LABS_BANNER_ASCII=0, coerente con
# startup-banner.sh.
if [ "${ASSISTED_LABS_BANNER_ASCII:-1}" = "1" ]; then
  BX_TL='+'; BX_HB='-'; BX_TR='+'; BX_VB='|'; BX_BL='+'; BX_BR='+'
else
  BX_TL='╔'; BX_HB='═'; BX_TR='╗'; BX_VB='║'; BX_BL='╚'; BX_BR='╝'
fi
BOX_W=44
box_top()     { printf '%s' "$BX_TL"; printf '%*s' "$BOX_W" "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_TR"; }
box_mid()     { local t="$1"; local pad=$((BOX_W - $(disp_w "$t"))); printf '%s' "$BX_VB"; printf '%s%*s' "$t" "$pad" ""; printf '%s\n' "$BX_VB"; }
box_bottom()  { printf '%s' "$BX_BL"; printf '%*s' "$BOX_W" "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_BR"; }

usage() {
  box_top
  box_mid "  lab — Assisted Linux Labs"
  box_bottom
  cat <<'EOF'

USO
  lab <comando> [lab-id] [opzioni]

COMANDI
  list                         elenco esercizi
  start  <lab-id>              reset + mostra consegna (parti da zero)
  task   <lab-id>              mostra consegna SENZA resettare
  check  <lab-id>              valida il lavoro (NON resetta se fallisce)
  hint   <lab-id>              prossimo indizio (uno alla volta)
  hint   <lab-id> --all        tutti gli indizi
  hint   <lab-id> --reset      riparte dagli indizi
  solution <lab-id>            mostra una soluzione possibile
  reset  <lab-id>              ripristina SOLO quel lab
  reset  --all                azzera TUTTI i lab in un colpo
  status                       avanzamento di tutti i lab
  mode   [standard|arcade|hardcade] visualizza o cambia modalita di apprendimento
  doctor                       diagnosi ambiente
  quit                         chiude la sessione e il terminale
  help                         questo messaggio
  readme                       guida estesa
  anim  <nome>                 anteprima animazioni (fireworks, rain, all)

EOF
  cat <<'EOF2'
UTILITY (comandi Linux disponibili nel container)
EOF2
  two_col 30 "$(cmd 'tree') [percorso]" "mostra l'albero di file e directory"
  two_col 30 "$(cmd 'history')" "mostra i comandi eseguiti nella shell"
  two_col 30 "$(cmd 'tail') [-n N] <file>" "mostra le ultime N righe di un file"
  two_col 30 "$(cmd 'tail -f') <file>" "segue nuove righe in tempo reale (Ctrl+C per uscire)"
  two_col 30 "$(cmd '<comando> --help')" "guida rapida integrata (es. ls --help)"
  two_col 30 "$(cmd 'man') <comando>" "manuale completo (es. man cp)"
  cat <<'EOF'

FLUSSO
  1. lab list
  2. lab start 01-filesystem
  3. cd nel WORKDIR indicato e digita i comandi a mano
  4. lab check 01-filesystem
  5. se fallisce: lab hint 01-filesystem  (il lavoro resta intatto)
  6. lab solution 01-filesystem  solo a fine esercizio

NOTE
  - check NON cancella i tuoi file. Solo start/reset lo fanno.
  - gli hint vanno dal concetto al comando: parti dal primo, rilancia per il prossimo.
  - dopo un check OK appare il ripasso "PERCHE FUNZIONA".
  - per scrivere testo in un file: printf (preciso) oppure echo (newline finale ok).
  - i file di lavoro vivono nella root della modalita corrente (volume Docker)
  - i lab ufficiali vivono in /opt/assisted-labs     (immagine)

ESEMPI
  lab list
  lab start 01-filesystem
  lab check 01-filesystem
  lab hint  01-filesystem
EOF
}

ensure_state() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true
}

# Benvenuto breve: mostrato da `lab` senza argomenti. Dettagli su `lab help`.
# Al PRIMO avvio (nessuna modalita scelta) propone un menu per scegliere la lab mode.
welcome() {
  box_top
  box_mid "  Assisted Linux Labs"
  box_mid "  il tuo laboratorio Linux, pronto per te."
  box_bottom
  printf '\n'
  printf 'Sei in una sandbox sicura: sperimenta senza timore.\n'
  printf '\n'

  # Menu di scelta della modalita: disponibile ad OGNI avvio, non solo al primo.
  ensure_state
  local cur_mode="standard"
  if is_hardcade; then cur_mode="hardcade"
  elif is_arcade;  then cur_mode="arcade"; fi
  hdr "SCEGLI LA MODALITA"
  printf 'Modalita attuale: %s\n' "$cur_mode"
  printf 'Puoi cambiarla quando vuoi (anche in seguito con:  lab mode).\n'
  printf '\n'
  printf '  %s\n' "$(cmd '[1] Standard')"
  printf '      Facile, guida passo-passo che tiene per mano.\n'
  printf '      Tentativi illimitati e indizi gratuiti. Consigliata per iniziare.\n'
  printf '\n'
  printf '  %s\n' "$(cmd '[2] Arcade')"
  printf '      Sfida a 3 vite con timer, indizi limitati (lampadine) e ostacoli.\n'
  printf '\n'
  local choices="1/2"
  if is_hardcade || arcade_easter_unlocked || [ "${LAB_EH_UNLOCK:-}" = "1" ]; then
    printf '  %s\n' "$(cmd '[3] Hardcade')"
    printf '      Sfida segreta a 3 errori condivisi: si sblocca dopo una run\n'
    printf '      ARCADE perfetta (tutti i lab, 0 vite perse).\n'
    printf '\n'
    choices="1/2/3"
  fi
  printf '  [invio] = mantieni la modalita attuale (%s)\n' "$cur_mode"
  printf 'Scegli [%s, invio = mantieni] > ' "$choices"
  local scelta
  read -r scelta || scelta=""
  case "${scelta:-keep}" in
    keep|"")
      ok "Modalita invariata: $cur_mode"
      ;;
    2|arcade|Arcade|ARCADE)
      if is_hardcade; then
        warn "Sei in HARDCADE: non puoi cambiare modalita qui."
        printf 'Per uscire da HARDCADE:  lab mode standard --exit\n\n'
      else
        echo "arcade" > "$NORMAL_STATE_DIR/mode"
        echo 1 > "$NORMAL_STATE_DIR/mode-chosen"
        ok "Modalita impostata su ARCADE"
      fi
      ;;
    3|hardcade|Hardcade|HARDCADE)
      if is_hardcade; then
        ok "Resti in HARDCADE"
      elif ! arcade_easter_unlocked && [ "${LAB_EH_UNLOCK:-}" != "1" ]; then
        hardcade_refuse
      else
        mkdir -p "$HARDCADE_STATE_DIR"
        echo 1 > "$HARDCADE_STATE_DIR/active"
        echo 0 > "$HARDCADE_STATE_DIR/errors"
        STATE_DIR="$HARDCADE_STATE_DIR"
        echo 1 > "$HARDCADE_STATE_DIR/mode-chosen"
        ok "Modalita impostata su HARDCADE"
      fi
      ;;
    *|1|standard|std|classic|relax)
      if is_hardcade; then
        warn "Sei in HARDCADE: non puoi cambiare modalita qui."
        printf 'Per uscire da HARDCADE:  lab mode standard --exit\n\n'
      else
        echo "standard" > "$NORMAL_STATE_DIR/mode"
        echo 1 > "$NORMAL_STATE_DIR/mode-chosen"
        ok "Modalita impostata su STANDARD"
      fi
      ;;
  esac
  printf '\n'

  printf '  %-14s %s\n' "lab list"       "cosa posso fare qui"
  printf '  %-14s %s\n' "lab start <id>" "parti il primo esercizio"
  printf '  %-14s %s\n' "lab check <id>" "verifica il lavoro [non cancella nulla]"
  printf '  %-14s %s\n' "lab hint  <id>" "un indizio se ti blocchi"
  printf '\n'
  printf '  Prima cosa da fare:   lab list\n'
  printf '  Tutti i comandi:      lab help\n'
  printf '\n'
}

lab_ids() {
  find "$LABS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# Larghezza colonna TEMA: serve abbastanza spazio per il tema piu lungo
# (08-system-admin=44 su Alpine) senza troncare "logger" ne lasciare virgole sospese.
MAX_THEME_W=48

theme_col_width() {
  local max=4 id t
  for id in $(lab_ids); do
    t=$(cat "$LABS/$id/theme.txt" 2>/dev/null || printf '%s' "-")
    if [ "${#t}" -gt "$max" ]; then
      max="${#t}"
    fi
  done
  if [ "$max" -gt "$MAX_THEME_W" ]; then
    max="$MAX_THEME_W"
  fi
  printf '%s' "$max"
}

# Tronca il tema alla larghezza di colonna per evitare tabelle storte.
theme_str() {
  printf '%s' "$1" | cut -c1-"$MAX_THEME_W"
}

require_lab() {
  if [ "$#" -lt 1 ] || [ -z "${1:-}" ]; then
    die "manca lab-id. Prova: lab list"
  fi
  local id="$1"
  if ! [[ "$id" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    die "lab-id non valido: $id (usa solo lettere, numeri, '_' e '-')"
  fi
  LAB="$LABS/$id"
  LAB_ID="$id"
  if [ ! -d "$LAB" ]; then
    warn "lab sconosciuto: $id"
    printf 'lab disponibili:\n' >&2
    lab_ids | sed 's/^/  /' >&2
    exit 2
  fi
}

# Markdown → testo TTY: toglie fence/grassetto/backtick, ma non tocca
# il contenuto dei blocchi codice (es. "# build" resta "# build").
print_plain_md() {
  awk '
    function strip_inline(s) {
      while (match(s, /`[^`]+`/)) {
        s = substr(s, 1, RSTART-1) substr(s, RSTART+1, RLENGTH-2) substr(s, RSTART+RLENGTH)
      }
      while (match(s, /\*\*[^*]+\*\*/)) {
        s = substr(s, 1, RSTART-1) substr(s, RSTART+2, RLENGTH-4) substr(s, RSTART+RLENGTH)
      }
      return s
    }
    BEGIN { in_code = 0 }
    /^```/ { in_code = !in_code; next }
    {
      if (in_code) { print; next }
      sub(/^#{1,6}[[:space:]]+/, "")
      print strip_inline($0)
    }
  '
}

# Consegna in testo grezzo (niente markdown spezzato).
print_task() {
  local f="$LAB/README.md"
  local training_placeholder='${LAB_TRAINING_ROOT:-/workspace/training}'
  if [ ! -f "$f" ]; then
    die "manca README per $LAB_ID"
  fi
  hdr "LAB  $LAB_ID"
  sed -e "s#${training_placeholder}#$TRAINING_ROOT#g" "$f" | print_plain_md
  printf '\n'
  printf 'COMANDI UTILI\n'
  printf '  %s %s     # rivedi consegna\n' "$(cmd 'lab task')" "$LAB_ID"
  printf '  %s %s    # valida (non resetta)\n' "$(cmd 'lab check')" "$LAB_ID"
  printf '  %s %s      # indizio successivo\n' "$(cmd 'lab hint')" "$LAB_ID"
  printf '  %s %s     # azzera SOLO questo lab\n' "$(cmd 'lab reset')" "$LAB_ID"
  printf '\n'
}

safe_cwd() {
  # Evita getcwd errors se l'utente era dentro una dir cancellata dal reset.
  cd /workspace 2>/dev/null || cd / 2>/dev/null || true
}

MAX_LIVES=3

is_arcade() {
  [ "$STATE_DIR" = "$HARDCADE_STATE_DIR" ] && return 1
  if [ -f "$STATE_DIR/mode" ]; then
    [ "$(cat "$STATE_DIR/mode")" = "arcade" ]
  else
    [ "${LAB_MODE:-standard}" = "arcade" ]
  fi
}

is_hardcade() { [ "$STATE_DIR" = "$HARDCADE_STATE_DIR" ]; }

is_standard() { ! is_arcade && ! is_hardcade; }

# ---------------------------------------------------------------------------
# Easter egg HARDCADE: si sblocca solo con una run ARCADE perfetta
# (tutti i lab completati senza mai perdere una vita).
# ---------------------------------------------------------------------------
ARCADE_PERFECT_FILE="$NORMAL_STATE_DIR/arcade-perfect"

all_labs_done() {
  local id
  for id in $(lab_ids); do
    [ -f "$STATE_DIR/done-$id" ] || return 1
  done
  return 0
}

# 1 = la carriera arcade non ha mai perso una vita; 0 o assente = no.
arcade_perfect() {
  [ -f "$ARCADE_PERFECT_FILE" ] && [ "$(cat "$ARCADE_PERFECT_FILE")" = "1" ]
}

set_arcade_perfect() { ensure_state; echo "$1" > "$ARCADE_PERFECT_FILE"; }

# --- Statistiche di gioco: streak lab puliti + contatore usi hint (per lab). ---
ARCADE_STREAK_FILE="$NORMAL_STATE_DIR/arcade-streak"

arcade_streak() {
  [ -f "$ARCADE_STREAK_FILE" ] && cat "$ARCADE_STREAK_FILE" || echo 0
}

set_arcade_streak() { ensure_state; echo "$1" > "$ARCADE_STREAK_FILE"; }

arcade_hint_uses() {
  local f="$NORMAL_STATE_DIR/hint-uses-$1"
  [ -f "$f" ] && cat "$f" || echo 0
}

set_arcade_hint_uses() { ensure_state; echo "$2" > "$NORMAL_STATE_DIR/hint-uses-$1"; }

# Un messaggio casuale tra 5 per celebrare una streak di lab puliti.
arcade_streak_message() {
  local msgs=(
    'Avanti così!'
    'Tieni duro, stai andando benissimo.'
    'Ritmo perfetto: continua così.'
    'Ottimo lavoro, la costanza paga.'
    'Sei in forma, non fermarti ora.'
  )
  local idx=$((RANDOM % ${#msgs[@]}))
  printf '%s\n' "${msgs[idx]}"
}

# In ARCADE ogni 2 usi di hint per-lab costa 1 cuore (contatore hint-uses-<id>).
arcade_hint_penalty() {
  local id="$1"
  local u
  u=$(arcade_hint_uses "$id")
  u=$((u + 1))
  set_arcade_hint_uses "$id" "$u"
  if [ $((u % 2)) -eq 0 ]; then
    local lives
    lives=$(get_lives "$id")
    if [ "$lives" -gt 0 ]; then
      lives=$((lives - 1))
      set_lives "$id" "$lives"
      warn "hai accumulato 2 indizi in questo lab: -1 vita!"
      printf 'Vite attuali: %s\n\n' "$(render_lives "$lives")"
      set_arcade_perfect 0   # anche l'abuso di indizi invalida la run perfetta
    fi
  fi
}

# --- Easter egg HARDCADE: aiuto (hint/solution) OTK per lab. ---
# La PRIMA consultazione di hint o solution in un lab costa 1 errore, parte la
# cascata e l'help resta disabilitato per quel lab (file help-used-<id>).
hardcade_help_used() {
  [ -f "$HARDCADE_STATE_DIR/help-used-$LAB_ID" ]
}

hardcade_use_help() {
  ensure_state
  if hardcade_help_used; then
    hdr "AIUTO BLOCCATO"
    printf 'L aiuto per questo lab e gia stato consumato.\n'
    printf 'Prova a risolvere da solo.\n\n'
    return 1
  fi
  echo 1 > "$HARDCADE_STATE_DIR/help-used-$LAB_ID"
  ascii_rain
  local errors used
  errors=$(hardcade_errors)
  used=$((errors + 1))
  echo "$used" > "$HARDCADE_STATE_DIR/errors"
  if [ "$used" -ge 3 ]; then
    warn "AIUTO CONSUMATO — terzo errore: HARDCADE GAME OVER"
    hardcade_game_over
  fi
  warn "AIUTO CONSUMATO — errore HARDCADE $used/3"
  printf 'Vite rimaste: %s\n' "$(render_hardcade_lives)"
  printf 'Per questo lab l aiuto ora e disabilitato.\n\n'
  return 0
}

# Sbloccata solo se: siamo in arcade, run perfetta e tutta completata.
arcade_easter_unlocked() {
  is_arcade && arcade_perfect && all_labs_done
}

hardcade_errors() {
  [ -f "$HARDCADE_STATE_DIR/errors" ] && cat "$HARDCADE_STATE_DIR/errors" || echo 0
}

render_hardcade_lives() {
  local errors remaining
  errors="$(hardcade_errors)"
  remaining=$((3 - errors))
  [ "$remaining" -lt 0 ] && remaining=0
  render_lives "$remaining" 3
}

hardcade_banner() {
  printf '\n'
  printf '%s' "$BX_TL"; printf '%*s' 38 "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_TR"
  printf '%s              GAME OVER               %s\n' "$BX_VB" "$BX_VB"
  printf '%s' "$BX_BL"; printf '%*s' 38 "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_BR"
  sleep 0.25
  printf '\r              G A M E   O V E R       '
  sleep 0.25
  printf '\r              G A M E   O V E R       \n\n'
}

hardcade_game_over() {
  local id
  for id in $(lab_ids); do
    bash "$LABS/$id/reset.sh" >/dev/null 2>&1 || true
  done
  rm -f "$HARDCADE_STATE_DIR/done-"* "$HARDCADE_STATE_DIR/hint-"* \
        "$HARDCADE_STATE_DIR/lives-"* "$HARDCADE_STATE_DIR/errors" \
        "$HARDCADE_STATE_DIR/help-used-"* "$HARDCADE_STATE_DIR/mode-chosen" \
        "$HARDCADE_STATE_DIR/active"
  rmdir "$HARDCADE_STATE_DIR" 2>/dev/null || true
  hardcade_banner
  printf 'La sessione HARDCADE e i suoi progressi sono stati azzerati.\n'
  printf 'ATTENZIONE: se avevi gia risolto qualche esercizio, il lavoro valido\n'
  printf 'viveva su un salvataggio separato: i tuoi lab STANDARD/ARCADE restano\n'
  printf 'intatti. HARDCADE si chiude qui: il prossimo lab parte nella tua\n'
  printf 'modalita precedente (STANDARD o ARCADE). Per riprovare la sfida:\n'
  printf '  lab mode hardcade --force\n\n'
  exit 42
}

# --- Animazioni: schermata dedicata e ripristino sicuro del terminale.
# Le animazioni disegnano sullo "schermo alternato": all'ingresso si salva la
# schermata del prompt (quella reale) e si disegna su un buffer separato;
# all'uscita quel buffer viene buttato e torna identico il prompt. Cosi non
# resta MAI sporcizia sul terminale vero. Un trap ripristina cursore e buffer
# anche se l'utente interrompe (Ctrl-C) nel bel mezzo dell'animazione.
anim_trap() {
  printf '\033[0m\033[?25h\033[?1049l'   # attributi normali, cursore visibile, esci dal buffer alternato
  trap - INT TERM EXIT
}
# Ripristino forzato su Ctrl-C (SIGINT/SIGTERM): ripristina il terminale e SI
# ESCE subito, cosi l'animazione non continua a ridisegnare sulla schermata
# reale appena ripristinata (che lascerebbe residui).
anim_interrupt() {
  anim_trap
  exit 130
}
anim_enter() {
  [ -t 1 ] || return 1
  printf '\033[?1049h\033[2J\033[H\033[?25l'   # entra nel buffer alternato, pulisci, nascondi cursore
  trap 'anim_interrupt' INT TERM
  trap 'anim_trap' EXIT
  return 0
}
anim_leave() {
  [ -t 1 ] || return 0
  anim_trap
  return 0
}

# Cascata "Matrix" pulita, usata come intro dell'easter egg HARDCADE.
# Cornice, titolo e gocce verticali a "streak" che cadono, disegnate sul buffer
# alternato con cancelletto della coda a ogni frame (niente residui).
# Viene saltata se non c'e un terminale (output reindirizzato o make test).
ascii_rain() {
  [ -t 1 ] || return 0
  local cols rows x y h ny len head tail inner_top inner_bot drop_cells
  cols=$(tput cols 2>/dev/null || echo 80)
  rows=$(tput lines 2>/dev/null || echo 24)
  cols=$((cols > 30 ? cols : 80))
  rows=$((rows > 12 ? rows : 24))
  local inner_top=3
  local inner_bot=$((rows - 2))

  anim_enter || return 0
  # Cornice verde scuro.
  printf '\033[%d;1H\033[32m┌%s┐\033[0m' 1 "$(printf '─%.0s' $(seq 1 $((cols - 2))))"
  printf '\033[%d;1H\033[32m└%s┘\033[0m' "$rows" "$(printf '─%.0s' $(seq 1 $((cols - 2))))"
  for r in $(seq 2 $((rows - 1))); do
    printf '\033[%d;1H\033[32m│\033[0m' "$r"
    printf '\033[%d;%dH\033[32m│\033[0m' "$r" "$cols"
  done
  # Titolo dentro la cornice.
  local title='M A T R I X   R A I N'
  local tx=$(((cols - ${#title}) / 2))
  [ "$tx" -lt 1 ] && tx=1
  printf '\033[%d;%dH\033[1;32m%s\033[0m' "$inner_top" "$tx" "$title"

  # Gocce verticali: una per colonna, ognuna con testa █ e coda ▓░ che cadono.
  # A ogni frame si cancella la cella appena oltre la coda, cosi la goccia
  # "scorre" pulita senza lasciare tracce accumulate.
  local ncol run frame len x
  ncol=$((cols - 6)); [ "$ncol" -lt 1 ] && ncol=1
  run=$((rows * 2))
  for frame in $(seq 1 "$run"); do
    for ((x = 3; x <= cols - 3; x += 2)); do
      len=$((3 + RANDOM % 4))
      y=$(( inner_top + 2 + ((frame + x) % (inner_bot - inner_top - 2)) ))
      [ "$y" -lt $((inner_top + 1)) ] && y=$((inner_top + 1))
      [ "$y" -gt $((inner_bot - 1)) ] && y=$((inner_bot - 1))
      # cancella la cella appena sotto la coda (frame pulito)
      ny=$((y - len - 1))
      if [ "$ny" -ge $((inner_top + 1)) ]; then
        printf '\033[%d;%dH\033[0m \033[0m' "$ny" "$x"
      fi
      # testa luminosa
      printf '\033[%d;%dH\033[1;9%dm█\033[0m' "$y" "$x" "$((2 + RANDOM % 8))"
      for h in $(seq 1 "$len"); do
        ny=$((y - h))
        [ "$ny" -lt $((inner_top + 1)) ] && break
        ch='░'; [ "$h" -eq 1 ] && ch='▓'
        printf '\033[%d;%dH\033[0;3%dm%s\033[0m' "$ny" "$x" "$((2 + RANDOM % 8))" "$ch"
      done
    done
    sleep 0.035
  done

  # Dissolvenza finale: spegni gradualmente le colonne.
  for f in $(seq 1 3); do
    for x in $(seq 3 $((cols - 2))); do
      printf '\033[%d;%dH\033[0m \033[0m' "$((inner_top + RANDOM % (inner_bot - inner_top)))" "$x"
    done
    sleep 0.06
  done

  anim_leave
}

# Fuochi d'artificio ASCII animati, mostrati al completamento di tutti i lab.
# Quattro fasi: lancio dei razzi (dal basso verso l'alto con scia di scintille),
# esplosioni in raggiera radiale simmetrica, pioggia di confetti, banner 9/9.
# Colori: rosso(31) verde(32) giallo(33) blu(34) magenta(35) ciano(36).
ascii_fireworks() {
  [ -t 1 ] || return 0
  anim_enter || return 0
  local cols rows f i x y dx dy nx ny apice cy
  cols=$(tput cols 2>/dev/null || echo 80)
  rows=$(tput lines 2>/dev/null || echo 24)
  cols=$((cols > 30 ? cols : 80))
  rows=$((rows > 8 ? rows : 20))
  cy=$((rows / 2 - 2)); [ "$cy" -lt 2 ] && cy=2

  # FASE 1: lancio del razzo con scia + esplosione in raggiera, frame pulito
  # (ogni esplosione viene cancellata prima della successiva).
  for f in $(seq 1 6); do
    x=$((6 + RANDOM % (cols - 14)))
    apice=$((2 + RANDOM % 5))
    # lancio: cancella la scia dietro, poi disegna la testa
    for r in $(seq $rows -1 $apice); do
      printf '\033[%d;%dH\033[0m \033[0m' "$((r + 1))" "$x"
      printf '\033[%d;%dH\033[1;3%dm*\033[0m' "$r" "$x" "$((1 + RANDOM % 6))"
      sleep 0.008
    done
    # esplosione: raggi anulari + nucleo bianco
    for i in 0 1 2 3 4 5 6 7; do
      dx=$(( (i % 4 == 0) ? 0 : (i % 3 == 0 ? 3 : 2) ))
      dy=$((i % 2 == 0 ? 2 : 1))
      nx=$(( x + (i < 4 ? dx : -dx) )); [ "$nx" -lt 1 ] && nx=1; [ "$nx" -gt $((cols - 1)) ] && nx=$((cols - 1))
      ny=$(( apice - (i % 2 == 0 ? dy : -dy) )); [ "$ny" -lt 1 ] && ny=1
      printf '\033[%d;%dH\033[1;3%dm*\033[0m' "$ny" "$nx" "$((1 + RANDOM % 6))"
    done
    printf '\033[%d;%dH\033[1;37m*\033[0m' "$apice" "$x"
    sleep 0.12
    # pulisci esplosione e colonna prima del razzo successivo (nessun residuo)
    for i in 0 1 2 3 4 5 6 7; do
      dx=$(( (i % 4 == 0) ? 0 : (i % 3 == 0 ? 3 : 2) ))
      dy=$((i % 2 == 0 ? 2 : 1))
      nx=$(( x + (i < 4 ? dx : -dx) )); [ "$nx" -lt 1 ] && nx=1; [ "$nx" -gt $((cols - 1)) ] && nx=$((cols - 1))
      ny=$(( apice - (i % 2 == 0 ? dy : -dy) )); [ "$ny" -lt 1 ] && ny=1
      printf '\033[%d;%dH\033[0m \033[0m' "$ny" "$nx"
    done
    printf '\033[%d;%dH\033[0m \033[0m' "$apice" "$x"
    sleep 0.04
  done

  # FASE 2: pioggia di confetti breve (chiara e a bassa densita).
  for f in $(seq 1 8); do
    for ((x = 2; x <= cols - 1; x += 4)); do
      y=$((2 + RANDOM % (rows - 4)))
      printf '\033[%d;%dH\033[1;3%dm.\033[0m' "$y" "$x" "$((1 + RANDOM % 6))"
    done
    sleep 0.04
  done

  # FASE 3: banner finale (solo se tutti i lab sono completati).
  if all_labs_done; then
    printf '\033[%d;1H\033[0m\033[1;33m    COMPLETATI 9/9 LABORATORI!    \033[0m' "$cy"
    sleep 0.5
  fi

  anim_leave
}

# Completamento di TUTTI i lab: fuochi d'artificio + messaggio + reset su conferma.
# Solo in modalita STANDARD (arcade ha il suo Game Over, hardcade e bloccato).
congrats_all_done() {
  is_standard || return 0
  all_labs_done || return 0
  [ -f "$NORMAL_STATE_DIR/congrats-shown" ] && return 0
  echo 1 > "$NORMAL_STATE_DIR/congrats-shown"
  # Isoliamo da set -e/pipefail: in questo blocco interattivo un comando
  # che "fallisce" non deve terminare lo script nel mezzo dell anteprima.
  (
    set +e
    ascii_fireworks
    hdr "COMPLIMENTI!"
    printf '  Hai completato tutti i %s laboratori!\n' "$(lab_ids | wc -l | tr -d ' ')"
    printf '\n'
    printf '  Queste sono le basi per il decollo.\n'
    printf '  Volare e atterrare richiedera impegno.\n'
    printf '\n'
    printf '  Vuoi ripartire da zero e ripetere l allenamento?\n'
    printf '  [s/N] (s = si, reset di tutti i lab; invio = continua) > '
    read -r risp || risp=""
    case "${risp:-}" in
      s|S|si|sì|Si|SI|y|Y|yes|YES)
        hdr "RESET  TUTTI I LAB"
        for id in $(lab_ids); do
          bash "$LABS/$id/reset.sh" >/dev/null 2>&1 || true
          rm -f "$STATE_DIR/done-$id" "$STATE_DIR/hint-$id" "$STATE_DIR/lives-$id" \
                "$NORMAL_STATE_DIR/hint-uses-$id" "$NORMAL_STATE_DIR/fail-$id"
        done
        rm -f "$ARCADE_PERFECT_FILE" "$NORMAL_STATE_DIR/congrats-shown"
        ok "tutti i lab azzerati — buon nuovo allenamento!"
        printf '\n'
        ;;
      *)
        printf 'Nessun reset effettuato. Puoi ricominciare quando vuoi con: lab reset --all\n\n'
        ;;
    esac
  )
}

hardcade_refuse() {
  hr
  printf ' ??? ??? ??? ??? ??? ??? ??? ??? ??? ???\n'
  printf '  La modalita HARDCADE e una sfida segreta.\n'
  printf '  Si rivela solo a chi completa TUTTI i lab in modalita\n'
  printf '  ARCADE senza mai perdere un cuore (run perfetta).\n'
  printf ' ??? ??? ??? ??? ??? ??? ??? ??? ??? ???\n\n'
  printf 'Hai gia sbloccato? Controlla:  lab status   e   lab mode\n\n'
  exit 2
}

cmd_mode() {
  ensure_state
  if is_hardcade; then
    if [ "${1:-}" = "standard" ] && [ "${2:-}" = "--exit" ]; then
      rm -f "$HARDCADE_STATE_DIR/active" "$HARDCADE_STATE_DIR/errors" \
            "$HARDCADE_STATE_DIR/help-used-"*
      rmdir "$HARDCADE_STATE_DIR" 2>/dev/null || true
      ok "Uscita da HARDCADE: i progressi hardcade sono stati abbandonati."
      printf 'I tuoi lab STANDARD/ARCADE sono intatti. Riprendi con:  lab list\n\n'
      return 0
    fi
    ok "Modalita corrente: HARDCADE (3 errori condivisi per sessione)"
    printf 'Sessione bloccata: non e possibile cambiare modalita qui.\n'
    printf 'Per uscire da HARDCADE e tornare al corso:  lab mode standard --exit\n'
    printf '\n'
    printf 'Giocatore: %s\n' "$(id -un 2>/dev/null || printf '?')"
    printf 'Vite disponibili: %s\n\n' "$(render_hardcade_lives)"
    return 0
  fi
  if [ "$#" -eq 0 ]; then
    if is_arcade; then
      ok "Modalita corrente: ARCADE (3 vite ❤️ ❤️ ❤️ con Game Over abilitato)"
    else
      ok "Modalita corrente: STANDARD (tentativi infiniti, niente vite perse, apprendimento sereno)"
    fi
    printf 'Per cambiare modalita:\n'
    printf '  lab mode standard   # modalita standard (consigliata per novizi)\n'
    printf '  lab mode arcade     # modalita arcade (sfida a 3 vite con cuori)\n\n'
    printf '  lab mode hardcade   # sfida segreta: si sblocca con una run ARCADE\n'
    printf '                      # perfetta (tutti i lab, 0 cuori persi)\n\n'
    return 0
  fi
  case "${1:-}" in
    standard|std|classic|relax)
      echo "standard" > "$STATE_DIR/mode"
      ok "Modalita impostata su STANDARD (tentativi illimitati, niente vite perse)"
      printf 'Ora puoi lavorare con la massima tranquillita!\n\n'
      ;;
    arcade|lives|hardcore)
      echo "arcade" > "$STATE_DIR/mode"
      # Avvia la "run perfetta": 1 finche non perdi una vita (resta 0 se gia persa).
      if [ ! -f "$ARCADE_PERFECT_FILE" ]; then
        set_arcade_perfect 1
      fi
      ok "Modalita impostata su ARCADE (3 vite ❤️ ❤️ ❤️ con Game Over abilitato)"
      printf 'Buona sfida!\n\n'
      ;; 
    hardcade)
      # Easter egg: sbloccato solo con run ARCADE perfetta.
      # Bypass esplicito: env LAB_EH_UNLOCK=1  oppure  lab mode hardcade --force
      if ! arcade_easter_unlocked &&
         [ "${LAB_EH_UNLOCK:-}" != "1" ] &&
         [ "${2:-}" != "--force" ]; then
        hardcade_refuse
      fi
      ascii_rain
      mkdir -p "$HARDCADE_STATE_DIR"
      echo 1 > "$HARDCADE_STATE_DIR/active"
      echo 0 > "$HARDCADE_STATE_DIR/errors"
      rm -f "$HARDCADE_STATE_DIR/done-"* "$HARDCADE_STATE_DIR/hint-"* "$HARDCADE_STATE_DIR/lives-"*
      STATE_DIR="$HARDCADE_STATE_DIR"
      ok "Modalita HARDCADE attivata (3 errori condivisi per sessione)"
      printf 'Salvataggio separato: %s\n' "$HARDCADE_STATE_DIR"
      printf 'La modalita e irreversibile per questa sessione.\n\n'
      ;;
    *)
      die "modalita non riconosciuta: $1 (usa 'standard', 'arcade' o 'hardcade')"
      ;;
  esac
}

render_lives() {
  local count="$1"
  local max="${2:-$MAX_LIVES}"
  local str=""
  for ((i=1; i<=max; i++)); do
    if [ "$i" -le "$count" ]; then
      str="${str}❤️ "
    else
      str="${str}🖤 "
    fi
  done
  printf '%s [%d/%d]' "$str" "$count" "$max"
}

# Numero di hint disponibili in ARCADE: lampadine fixe (3).
MAX_HINTS=3
HINT_STATE_DIR="${NORMAL_STATE_DIR:-/workspace/training/.lab-state}"

get_hints() {
  local id="$1"
  local hf="$HINT_STATE_DIR/hints-$id"
  if [ -f "$hf" ]; then
    cat "$hf"
  else
    echo "$MAX_HINTS"
  fi
}

set_hints() {
  local id="$1"
  local val="$2"
  ensure_state
  echo "$val" > "$HINT_STATE_DIR/hints-$id"
}

# 3 lampadine: 💡 accesa = hint disponibile, ⚪ spenta = consumato.
render_hints() {
  local count="$1"
  local str=""
  for ((i=1; i<=MAX_HINTS; i++)); do
    if [ "$i" -le "$count" ]; then
      str="${str}💡 "
    else
      str="${str}⚪ "
    fi
  done
  printf '%s' "$str"
}

# Timer lab ARCADE: registra start + limite random 5-10 min (300-600s).
arcade_timer_start() {
  ensure_state
  local start
  start=$(date +%s)
  local limit=$((300 + RANDOM % 301))
  echo "$start" > "$STATE_DIR/timer-start-$LAB_ID"
  echo "$limit" > "$STATE_DIR/timer-limit-$LAB_ID"
}

# Secondi rimanenti; 0 = scaduto, -1 = nessun timer attivo.
arcade_timer_remaining() {
  local id="$1"
  local sf="$STATE_DIR/timer-start-$id"
  local lf="$STATE_DIR/timer-limit-$id"
  if [ ! -f "$sf" ] || [ ! -f "$lf" ]; then
    echo -1
    return
  fi
  local start limit now elapsed
  start=$(cat "$sf")
  limit=$(cat "$lf")
  now=$(date +%s)
  elapsed=$((now - start))
  local rem=$((limit - elapsed))
  [ "$rem" -lt 0 ] && rem=0
  echo "$rem"
}

# Render leggibile del tempo rimanente: mm:ss.
format_mmss() {
  local secs="$1"
  printf '%02d:%02d' $((secs / 60)) $((secs % 60))
}

# Render della colonna vite come celle a larghezza costante: render_lives
# restituisce sempre 14 celle di display, a prescindere dal numero di vite
# (cuori e cuori neri sono entrambi larghi 2). Aggiungiamo padding fisso in
# spazi per allineare la colonna del TEMA anche nei terminali a larghezza.
VITE_PAD_SPACES=3
lives_col() {
  printf '%s%*s' "$1" "$VITE_PAD_SPACES" ""
}

get_lives() {
  local id="$1"
  local lf="$STATE_DIR/lives-$id"
  if [ -f "$lf" ]; then
    cat "$lf"
  else
    echo "$MAX_LIVES"
  fi
}

set_lives() {
  local id="$1"
  local val="$2"
  ensure_state
  echo "$val" > "$STATE_DIR/lives-$id"
}

reset_lab() {
  local id="$1"
  safe_cwd
  bash "$LABS/$id/reset.sh" || die "reset fallito per $id"
  ensure_state
  if ! is_hardcade; then set_lives "$id" "$MAX_LIVES"; fi
  set_hints "$id" "$MAX_HINTS"
  rm -f "$STATE_DIR/hint-$id" "$STATE_DIR/done-$id" \
        "$STATE_DIR/timer-start-$id" "$STATE_DIR/timer-limit-$id" \
        "$NORMAL_STATE_DIR/hint-uses-$id" "$NORMAL_STATE_DIR/fail-$id" \
        "$HARDCADE_STATE_DIR/help-used-$id"
}

do_reset() {
  reset_lab "$LAB_ID"
  # Se l'utente era in una subdir del lab, riportalo su /workspace.
  # Messaggio in chiaro per un principiante: cwd = dove sei adesso.
  printf 'Sei adesso in: /workspace  (la tua cartella di lavoro corrente).\n'
  printf 'Per iniziare il lab appena avviato, entra nella sua cartella di lavoro: usa il comando  cd  indicato nella sezione AVVIO della consegna.\n'
}

mark_done() {
  ensure_state
  date -u +'%Y-%m-%dT%H:%M:%SZ' > "$STATE_DIR/done-$LAB_ID"
}

is_done() {
  [ -f "$STATE_DIR/done-$1" ]
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------
cmd_list() {
  hdr "LAB DISPONIBILI"
  local tw
  tw=$(theme_col_width)
  if is_hardcade; then
    printf "%-22s  %-6s  %-15s  %-${tw}s\n" "ID" "STATO" "VITE SESSIONE" "TEMA"
  elif is_arcade; then
    printf "%-22s  %-6s  %-16s  %-12s  %-${tw}s\n" "ID" "STATO" "VITE" "INDIZI" "TEMA"
  else
    printf "%-22s  %-6s  %-${tw}s\n" "ID" "STATO" "TEMA"
  fi
  hr
  local id mark theme lives hints
  for id in $(lab_ids); do
    if is_done "$id"; then
      mark="DONE"
    else
      mark="-"
    fi
    theme=$(cat "$LABS/$id/theme.txt" 2>/dev/null || printf '%s' "-")
    if is_hardcade; then
      printf "%-22s  %-6s  %s%s\n" "$id" "$mark" "$(lives_col "$(render_hardcade_lives)")" "$(theme_str "$theme")"
    elif is_arcade; then
      lives=$(get_lives "$id")
      hints=$(get_hints "$id")
      printf "%-22s  %-6s  %-16s  %-12s  %s\n" "$id" "$mark" "$(render_lives "$lives")" "$(render_hints "$hints") [$hints/$MAX_HINTS]" "$(theme_str "$theme")"
    else
      printf "%-22s  %-6s  %s\n" "$id" "$mark" "$(theme_str "$theme")"
    fi
  done
  printf '\nAvvia:  lab start <id>\n'
  printf 'Stato:  lab status\n\n'
}

# Al primo `lab start` in modalita STANDARD ricorda l'uso di man/--help.
maybe_remind_man() {
  is_standard || return 0
  local flag="$NORMAL_STATE_DIR/man-reminder-shown"
  [ -f "$flag" ] && return 0
  echo 1 > "$flag"
  hdr "SUGGERIMENTO: man e --help"
  printf 'Ogni comando Linux ha una guida integrata:\n'
  printf '  %s    %s\n' "$(cmd '<comando> --help')" "# sintesi rapida delle opzioni"
  printf '  %s       %s\n' "$(cmd 'man <comando>')" "# manuale completo (es. man cp)"
  printf '\nEsempi:  %s   ·   %s   ·   %s\n' "$(cmd 'ls --help')" "$(cmd 'man mkdir')" "$(cmd 'man mv')"
  printf 'Esplora le opzioni da solo prima di chiedere un indizio!\n\n'
}

cmd_start() {
  require_lab "$@"
  hdr "START  $LAB_ID"
  printf 'Reset in corso...\n'
  do_reset
  printf '\n'
  hr
  ok "lab $LAB_ID pronto"
  if is_hardcade; then
    printf 'Vite iniziali/sessione: %s\n' "$(render_hardcade_lives)"
  elif is_arcade; then
    arcade_timer_start
    printf 'Vite iniziali: %s\n' "$(render_lives "$MAX_LIVES")"
    printf 'Indizi:        %s\n' "$(render_hints "$MAX_HINTS") [${MAX_HINTS}/${MAX_HINTS}]"
    printf 'Timer:         ⏳ %s  (limite sfida)\n' "$(format_mmss "$(arcade_timer_remaining "$LAB_ID")")"
  fi
  printf '\n'
  print_task
  maybe_remind_man
}

cmd_task() {
  require_lab "$@"
  print_task
}

# Feedback didattico per la modalita STANDARD: estrae dai controlli falliti
# il comando correttivo (X) e il comando di verifica (Y), al posto del
# semplice footer generico. Non tocca la resa di ARCADE/HARDCADE.
didactic_feedback() {
  local check_out="$1" line cmds=() veri=() i c
  while IFS= read -r line; do
    case "$line" in
      '        -> verifica: '*)
        veri+=("${line#*'-> verifica: '}")
        ;;
      '        -> '*)
        cmds+=("${line#*'-> '}")
        ;;
    esac
  done <<< "$check_out"
  local cc=${#cmds[@]}
  printf '  ATTENZIONE: non tutti i controlli sono passati.\n'
  printf '  Ecco come correggere gli errori rilevati:\n'
  printf '\n'
  if [ "$cc" -gt 0 ]; then
    for ((i = 0; i < cc; i++)); do
      c="${cmds[i]}"
      printf '    • %s\n' "$c"
      if [ "${#veri[@]}" -gt "$i" ]; then
        printf '      per verificare: %s\n' "${veri[i]}"
      fi
    done
  else
    printf '    (riprendi le consegne con: lab task %s)\n' "$LAB_ID"
  fi
  printf '\n'
  printf 'Poi rilancia il controllo con:  lab check %s\n\n' "$LAB_ID"
}

cmd_check() {
  require_lab "$@"
  safe_cwd
  hdr "CHECK  $LAB_ID"

  if is_hardcade; then
    local current_errors
    current_errors=$(hardcade_errors)
    if [ "$current_errors" -ge 3 ]; then hardcade_game_over; fi
  fi
  
  if is_arcade; then
    local current_lives
    current_lives=$(get_lives "$LAB_ID")
    if [ "$current_lives" -le 0 ]; then
      warn "Hai esaurito tutte le vite per il lab $LAB_ID."
      printf 'Vite attuali: %s\n\n' "$(render_lives 0)"
      printf 'Per ripartire con 3 nuove vite (reset pulito):\n'
      printf '  lab start %s   (oppure: lab reset %s)\n\n' "$LAB_ID" "$LAB_ID"
      exit 1
    fi
    # Timer: se scaduto, -1 vita rossa (i file NON vengono cancellati).
    local t_rem
    t_rem=$(arcade_timer_remaining "$LAB_ID")
    if [ "$t_rem" -eq 0 ] && [ -f "$STATE_DIR/timer-start-$LAB_ID" ]; then
      warn "TEMPO SCADUTO per $LAB_ID — hai perso 1 vita!"
      set_lives "$LAB_ID" $((current_lives - 1))
      current_lives=$((current_lives - 1))
      set_arcade_perfect 0
      set_arcade_streak 0
      if [ "$current_lives" -le 0 ]; then
        printf 'Vite rimaste: %s\n\n' "$(render_lives 0)"
        printf 'Hai esaurito le vite per tempo scaduto: i file restano, rilancia:\n'
        printf '  lab start %s\n\n' "$LAB_ID"
        exit 1
      fi
      printf 'Vite rimaste: %s\n\n' "$(render_lives "$current_lives")"
    fi
  fi

  set +e
  local check_out check_passed check_total
  check_out=$(bash "$LAB/check.sh" 2>&1)
  local status=$?
  set -e
  printf '%s\n' "$check_out"
  check_passed=$(printf '%s\n' "$check_out" | grep -c '  PASS  ' || true)
  check_total=$(printf '%s\n' "$check_out" | grep -cE '  (PASS|FAIL)  ' || true)
  printf '\n'
  if [ "$check_total" -gt 0 ]; then
    printf '  Riepilogo: %s/%s controlli superati\n' "$check_passed" "$check_total"
    printf '\n'
  fi
  if [ "$status" -eq 0 ]; then
    mark_done
    ok "LAB COMPLETATO: $LAB_ID"
    local arcade_bonus=0
    if is_arcade; then
      # Streak: il lab appena completato senza fallimenti incrementa il conto.
      if [ ! -f "$NORMAL_STATE_DIR/fail-$LAB_ID" ]; then
        local streak
        streak=$(arcade_streak)
        streak=$((streak + 1))
        if [ "$streak" -ge 3 ]; then
          arcade_bonus=1
          current_lives=$((current_lives + 1))
          [ "$current_lives" -gt "$MAX_LIVES" ] && current_lives="$MAX_LIVES"
          set_lives "$LAB_ID" "$current_lives"
          set_arcade_streak 0
        else
          set_arcade_streak "$streak"
        fi
      else
        rm -f "$NORMAL_STATE_DIR/fail-$LAB_ID"
      fi
    fi
    if is_hardcade; then
      printf 'Vite disponibili: %s\n' "$(render_hardcade_lives)"
    elif is_arcade; then
      printf 'Vite finali: %s\n' "$(render_lives "$current_lives")"
      if [ "$arcade_bonus" -eq 1 ]; then
        printf '🌟 Streak 3 lab puliti: +1 vita!  %s\n' "$(arcade_streak_message)"
      fi
    fi
    if [ -f "$LAB/why.txt" ]; then
      hdr "PERCHE FUNZIONA"
      cat "$LAB/why.txt"
      printf '\n'
    fi
    printf 'Prossimo: lab list   oppure   lab start <altro-id>\n\n'
    congrats_all_done
  else
    if is_hardcade; then
      local used=$((current_errors + 1))
      echo "$used" > "$HARDCADE_STATE_DIR/errors"
      if [ "$used" -ge 3 ]; then
        warn "check FALLITO — terzo errore: HARDCADE GAME OVER"
        hardcade_game_over
      fi
      warn "check FALLITO — errore HARDCADE $used/3"
      printf 'Vite rimaste: %s\n' "$(render_hardcade_lives)"
      printf 'I tuoi file NON sono stati cancellati.\n\n'
      exit "$status"
    fi
    if is_arcade; then
      local remaining=$((current_lives - 1))
      set_lives "$LAB_ID" "$remaining"
      set_arcade_perfect 0   # una vita persa: niente run perfetta -> hardcade resta bloccato
      set_arcade_streak 0    # un check fallito spezza la streak di lab puliti
      ensure_state
      echo 1 > "$NORMAL_STATE_DIR/fail-$LAB_ID"
      if [ "$remaining" -gt 0 ]; then
        warn "check FALLITO — hai perso 1 vita!"
        printf 'Vite rimaste: %s\n\n' "$(render_lives "$remaining")"
        printf 'I tuoi file NON sono stati cancellati. Correggi l errore e riprova:\n'
        printf '  lab hint  %s      # indizio (progressivo)\n' "$LAB_ID"
        printf '  lab task  %s      # rivedi la consegna\n' "$LAB_ID"
        printf '  lab check %s      # riprova dopo le correzioni\n' "$LAB_ID"
        printf '  lab reset %s      # SOLO se vuoi ripartire da zero\n' "$LAB_ID"
        printf '\n'
      else
        warn "Hai perso l'ultima vita per questo lab."
        printf 'Vite rimaste: %s\n\n' "$(render_lives 0)"
        printf 'Cosa fare adesso:\n'
        printf '  Hai esaurito le 3 vite. Per riprovare con 3 nuove vite:\n'
        printf '    lab start %s\n' "$LAB_ID"
        printf '  ATTENZIONE: start/reset azzerano anche il lavoro gia fatto\n'
        printf '  correttamente in questo lab. Se vuoi salvare qualcosa,\n'
        printf '  copialo prima in /workspace prima di rilanciare.\n'
        printf '  Per consultare la soluzione di riferimento:\n'
        printf '    lab solution %s\n' "$LAB_ID"
        printf '\n'
      fi
    else
      warn "check FALLITO — i tuoi file NON sono stati cancellati"
      printf '\n'
      didactic_feedback "$check_out"
      printf '(Indizi progressivi:  lab hint %s   ·   Rivedi la consegna:  lab task %s)\n' "$LAB_ID" "$LAB_ID"
    fi
    exit "$status"
  fi
}

get_hint_count() {
  local file="$1"
  if grep -q '^---$' "$file" 2>/dev/null; then
    awk 'BEGIN{c=1} /^---$/{c++} END{print c}' "$file"
  else
    grep -c . "$file" || echo 0
  fi
}

print_hint_block() {
  local file="$1"
  local index="$2"
  if grep -q '^---$' "$file" 2>/dev/null; then
    awk -v target="$index" '
      BEGIN { c=1; content="" }
      /^---$/ {
        if (c == target) {
          gsub(/^\n+|\n+$/, "", content);
          print content;
          found=1;
          exit;
        }
        c++;
        content="";
        next;
      }
      {
        if (content == "") content = $0;
        else content = content "\n" $0;
      }
      END {
        if (!found && c == target) {
          gsub(/^\n+|\n+$/, "", content);
          print content;
        }
      }
    ' "$file"
  else
    sed -n "${index}p" "$file"
  fi
}

print_all_hints() {
  local file="$1"
  if grep -q '^---$' "$file" 2>/dev/null; then
    awk '
      BEGIN { c=1; content="" }
      /^---$/ {
        gsub(/^\n+|\n+$/, "", content);
        printf "\n--- [HINT %d] ----------------------------------\n%s\n", c, content;
        c++;
        content="";
        next;
      }
      {
        if (content == "") content = $0;
        else content = content "\n" $0;
      }
      END {
        gsub(/^\n+|\n+$/, "", content);
        printf "\n--- [HINT %d] ----------------------------------\n%s\n", c, content;
      }
    ' "$file"
  else
    nl -ba "$file"
  fi
}

cmd_hint() {
  require_lab "$@"
  shift || true
  local mode="next"
  case "${1:-}" in
    --all)   mode="all" ;;
    --reset) mode="reset" ;;
    "")      mode="next" ;;
    *)       die "opzione hint sconosciuta: $1 (usa --all o --reset)" ;;
  esac

  local hf="$LAB/hint.txt"
  [ -f "$hf" ] || die "nessun hint per $LAB_ID"
  ensure_state
  local sf="$STATE_DIR/hint-$LAB_ID"
  local total
  total=$(get_hint_count "$hf")
  [ "$total" -gt 0 ] || die "hint.txt vuoto"

  if [ "$mode" = "reset" ]; then
    rm -f "$sf"
    ok "indizi azzerati per $LAB_ID"
    printf 'Rilancia: lab hint %s\n' "$LAB_ID"
    return 0
  fi

  # HARDCADE: la consultazione di un indizio consuma l'aiuto del lab (OTK).
  if is_hardcade && ! hardcade_use_help; then
    return 0
  fi
  local help_shown=0

  if [ "$mode" = "all" ]; then
    # In ARCADE il "all" e sconsigliato: consumerebbe solo concetto ma conta 1 lampadina.
    if is_arcade; then
      hdr "HINT  $LAB_ID"
      printf 'In modalita ARCADE gli indizi sono limitati (3 lampadine) e oscurati.\n'
      printf 'Usa:  lab hint %s     (concede 1 indizio, 1 lampadina)\n\n' "$LAB_ID"
      return 0
    fi
    hdr "HINT  $LAB_ID  (tutti - $total disponibili)"
    print_all_hints "$hf"
    printf '\n'
    help_shown=1
  else
    # ARCADE: ogni hint consuma 1 lampadina (max 3) e rivela l'indizio
    # successivo (dal concetto verso il comando), non quello ripetuto.
    if is_arcade; then
      local hints_left
      hints_left=$(get_hints "$LAB_ID")
      if [ "$hints_left" -le 0 ]; then
        hdr "HINT  $LAB_ID"
        printf 'Hai esaurito i 3 indizi (lampadine) per questo lab.\n'
        printf 'Risolvi senza aiuto o ricomincia: lab reset %s\n\n' "$LAB_ID"
        return 0
      fi
      set_hints "$LAB_ID" $((hints_left - 1))
      local n=0
      [ -f "$sf" ] && n=$(cat "$sf")
      n=$((n + 1))
      [ "$n" -gt "$total" ] && n="$total"
      echo "$n" > "$sf"
      hdr "HINT  $LAB_ID  (lampadine: $(render_hints $((hints_left - 1))))"
      print_hint_block "$hf" "$n"
      printf '\n'
      printf 'Lampadine rimaste: %s\n' "$(render_hints $((hints_left - 1)))"
      if [ "$n" -lt "$total" ]; then
        printf 'Prossimo indizio: lab hint %s\n\n' "$LAB_ID"
      else
        printf 'Ultimo indizio visualizzato.\n\n'
      fi
      help_shown=1
    else
    local n=0
    [ -f "$sf" ] && n=$(cat "$sf")
    n=$((n + 1))
    if [ "$n" -gt "$total" ]; then
      hdr "HINT  $LAB_ID"
      printf 'Hai gia visualizzato tutti gli indizi disponibili (%s/%s).\n' "$total" "$total"
      printf '  lab hint %s --all     # rivedili tutti insieme\n' "$LAB_ID"
      printf '  lab hint %s --reset   # riparti dal primo indizio\n' "$LAB_ID"
      printf '  lab solution %s       # consulta la soluzione di riferimento\n' "$LAB_ID"
      printf '\n'
      return 0
    fi
    echo "$n" > "$sf"
    hdr "HINT  $LAB_ID  ($n/$total)"
    print_hint_block "$hf" "$n"
    printf '\n'
    if [ "$n" -lt "$total" ]; then
      printf 'Prossimo indizio: lab hint %s\n\n' "$LAB_ID"
    else
      printf 'Questo era l ultimo indizio. Se ti serve ulteriore aiuto: lab solution %s\n\n' "$LAB_ID"
    fi
    help_shown=1
    fi
  fi

  # ARCADE: gli indizi non sono piu gratuiti — consumano vite in modo crescente
  # (1° gratis, poi +1 vita a ciascun uso fino a esaurire le lampadine).
  if is_arcade && [ "$help_shown" -eq 1 ]; then
    local used lives
    used=$((MAX_HINTS - $(get_hints "$LAB_ID")))
    if [ "$used" -ge 2 ]; then
      lives=$(get_lives "$LAB_ID")
      if [ "$lives" -gt 0 ]; then
        lives=$((lives - 1))
        set_lives "$LAB_ID" "$lives"
        warn "gli indizi ora costano vite: -1 vita (ne restano $lives)"
        set_arcade_perfect 0
        printf 'Vite attuali: %s\n\n' "$(render_lives "$lives")"
      fi
    fi
  fi
}

cmd_solution() {
  require_lab "$@"
  # Modalita QA test (Lim): la soluzione deve restare introvabile durante un
  # test, altrimenti il check (che valida lo stato finale, non il processo)
  # produrrebbe falsi positivi. Nessuna soluzione, nessun marker: blocco secco.
  if [ "${LAB_QA_MODE:-0}" = "1" ]; then
    warn "LAB_QA_MODE attivo: soluzione bloccata (test Lim, niente falsi positivi)"
    printf 'Risolvi il lab con le tue conoscenze e gli hint; se ti blocchi,\n'
    printf 'segnalalo nel report come finding di qualita del corso.\n\n'
    return 1
  fi
  # HARDCADE: la soluzione e one-shot (OTK). Prima consultazione consuma l'aiuto
  # del lab e costa 1 errore; le successive sono bloccate.
  if is_hardcade && ! hardcade_use_help; then
    return 0
  fi
  hdr "SOLUTION  $LAB_ID"
  printf 'Leggi, non copiare a occhio chiuso.\n'
  hr
  grep -v '^lab check' "$LAB/solution.sh" || true
  printf '\n'
  hr
  printf 'Per applicarla (opzionale):\n'
  printf '  bash /opt/assisted-labs/labs/%s/solution.sh\n\n' "$LAB_ID"
}

cmd_reset() {
  if [ "${1:-}" = "--all" ] || [ "${1:-}" = "-a" ]; then
    hdr "RESET  TUTTI I LAB"
    local id
    for id in $(lab_ids); do
      reset_lab "$id"
      printf '  reset: %s\n' "$id"
    done
    # Nuova run: azzera il marcatore di run arcade perfetta.
    rm -f "$ARCADE_PERFECT_FILE"
    ok "tutti i lab azzerati"
    printf 'Avvia: lab list   oppure   lab start <id>\n\n'
    return 0
  fi
  require_lab "$@"
  hdr "RESET  $LAB_ID"
  do_reset
  ok "reset completato: $LAB_ID"
  printf 'Rivedi consegna: lab task %s\n\n' "$LAB_ID"
}

cmd_status() {
  ensure_state
  hdr "STATUS"
  local tw
  tw=$(theme_col_width)
  if is_hardcade; then
    printf "%-22s  %-6s  %-15s  %-${tw}s  %s\n" "ID" "STATO" "VITE SESSIONE" "TEMA" "COMPLETATO"
  elif is_arcade; then
    printf "%-22s  %-6s  %-16s  %-12s  %-${tw}s  %s\n" "ID" "STATO" "VITE" "INDIZI" "TEMA" "COMPLETATO"
  else
    printf "%-22s  %-6s  %-${tw}s  %s\n" "ID" "STATO" "TEMA" "COMPLETATO"
  fi
  hr
  local id theme lives hints
  for id in $(lab_ids); do
    theme=$(cat "$LABS/$id/theme.txt" 2>/dev/null || printf '%s' "-")
    if is_hardcade; then
      if is_done "$id"; then
        printf "%-22s  %-6s  %s%-${tw}s  %s\n" "$id" "DONE" "$(lives_col "$(render_hardcade_lives)")" "$(theme_str "$theme")" "$(cat "$STATE_DIR/done-$id")"
      else
        printf "%-22s  %-6s  %s%-${tw}s  %s\n" "$id" "TODO" "$(lives_col "$(render_hardcade_lives)")" "$(theme_str "$theme")" "-"
      fi
    elif is_arcade; then
      lives=$(get_lives "$id")
      hints=$(get_hints "$id")
      if is_done "$id"; then
        printf "%-22s  %-6s  %-16s  %-12s  %-${tw}s  %s\n" "$id" "DONE" "$(render_lives "$lives")" "$(render_hints "$hints") [$hints/$MAX_HINTS]" "$(theme_str "$theme")" "$(cat "$STATE_DIR/done-$id")"
      else
        printf "%-22s  %-6s  %-16s  %-12s  %-${tw}s  %s\n" "$id" "TODO" "$(render_lives "$lives")" "$(render_hints "$hints") [$hints/$MAX_HINTS]" "$(theme_str "$theme")" "-"
      fi
    else
      if is_done "$id"; then
        printf "%-22s  %-6s  %-${tw}s  %s\n" "$id" "DONE" "$(theme_str "$theme")" "$(cat "$STATE_DIR/done-$id")"
      else
        printf "%-22s  %-6s  %-${tw}s  %s\n" "$id" "TODO" "$(theme_str "$theme")" "-"
      fi
    fi
  done
  printf '\nI file di lavoro: %s\n' "$TRAINING_ROOT"
  printf 'Stato interno:    %s\n\n' "$STATE_DIR"
}

cmd_doctor() {
  hdr "DOCTOR"
  printf 'host-container\n'
  printf '  user:      %s\n' "$(id -un 2>/dev/null || echo ?)"
  printf '  cwd:       %s\n' "$(pwd 2>/dev/null || echo 'INVALID (cd /workspace)')"
  printf '  lab bin:   %s\n' "$(command -v lab 2>/dev/null || echo MISSING)"
  printf '  lab root:  %s\n' "$ROOT"
  printf '  workspace: /workspace\n'
  printf '  training:  %s\n' "$TRAINING_ROOT"
  if is_hardcade; then
    printf '  modalita:  HARDCADE (errori condivisi: %s/3)\n' "$(hardcade_errors)"
  elif is_arcade; then
    printf '  modalita:  ARCADE (3 vite ❤️ ❤️ ❤️, indizi 💡💡💡, timer sfida)\n'
  else
    printf '  modalita:  STANDARD (rilassato)\n'
  fi
  printf '\n'

  printf 'lab installati in immagine (/opt/assisted-labs):\n'
  lab_ids | sed 's/^/  /'
  printf '\n'

  if [ -d /workspace/assisted-labs ]; then
    warn "trovata copia STALE su /workspace/assisted-labs"
    printf '  Il runtime usa SOLO /opt/assisted-labs (immagine).\n'
    printf '  La copia sul volume confonde e puo essere vecchia.\n'
    printf '  Rimuovila con:  rm -rf /workspace/assisted-labs\n'
    printf '  (i tuoi esercizi in /workspace/training restano intatti)\n\n'
  else
    ok "nessuna copia stale su /workspace/assisted-labs"
    printf '\n'
  fi

  local missing=0
  local t
  for t in bash ps top free nano less grep sed awk find stat sort uniq wc printf \
           mkdir cp mv rm chmod chown groupadd useradd usermod getent \
           pgrep sleep df du tar openrc logread logger ip ss ping curl ssh scp \
           rsync sudo crontab nc; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '  OK   %s\n' "$t"
    else
      printf '  MISS %s\n' "$t"
      missing=1
    fi
  done
  printf '\n'
  if [ "$missing" -eq 0 ]; then
    ok "tool base presenti"
  else
    warn "mancano tool — rebuild l'immagine"
  fi
  printf '\n'
  printf 'Volume: monta Alpine_Latest su /workspace\n'
  printf 'Avvio tipico (dall host):\n'
  printf '  docker run --rm -it -v Alpine_Latest:/workspace alpine-latest-assisted-labs:latest\n\n'
}

cmd_quit() {
  printf '\nChiusura della sessione Assisted Linux Labs...\n'
  kill -TERM "$PPID" 2>/dev/null || true
  exit 0
}

cmd_readme() {
  if [ -f "$ROOT/README.md" ]; then
    hdr "README"
    if [ -t 1 ] && command -v less >/dev/null 2>&1; then
      print_plain_md < "$ROOT/README.md" | less -R
    else
      print_plain_md < "$ROOT/README.md"
    fi
    printf '\n'
  else
    usage
  fi
}

# Anteprima delle animazioni senza doverle sbloccare. Utile per i costruttori.
#   lab anim fireworks   → fuochi d'artificio (completamento corso)
#   lab anim rain        → pioggia matrix pulita (intro hardcade)
#   lab anim all         → tutte in sequenza
cmd_anim() {
  local nome="${1:-all}"
  case "$nome" in
    fireworks|arti|fuochi) ascii_fireworks ;;
    rain|matrix|hardcade)  ascii_rain ;;
    all|""|--all|-a)
      hdr "ANIM  fireworks"
      ascii_fireworks
      hdr "ANIM  rain"
      ascii_rain
      ;;
    *)
      die "animazione sconosciuta: $nome (usa fireworks, rain o all)"
      ;;
  esac
  printf '\n'
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in
  list)            shift; cmd_list "$@" ;;
  start)           shift; cmd_start "$@" ;;
  task|show|cat)   shift; cmd_task "$@" ;;
  check)           shift; cmd_check "$@" ;;
  hint)            shift; cmd_hint "$@" ;;
  solution|sol)    shift; cmd_solution "$@" ;;
  reset)           shift; cmd_reset "$@" ;;
  status|stat)     shift; cmd_status "$@" ;;
  mode)            shift; cmd_mode "$@" ;;
  doctor|doc)      shift; cmd_doctor "$@" ;;
  quit|exit)       shift; cmd_quit "$@" ;;
  readme|guide)    shift; cmd_readme "$@" ;;
  anim|animazioni) shift; cmd_anim "$@" ;;
  help|-h|--help)  usage ;;
  version|--version) printf 'lab %s\n' "$VERSION" ;;
  "")
    printf '%s\n' "$(welcome)"
    ;;
  *)
    warn "comando sconosciuto: ${1:-}"
    printf '\n'
    usage
    exit 2
    ;;
esac
