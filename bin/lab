#!/usr/bin/env bash
# Assisted Linux Labs — CLI grezza da terminale.
set -euo pipefail

if [ -z "${LAB_ROOT:-}" ]; then
  if [ -d "/opt/assisted-labs/labs" ]; then
    ROOT="/opt/assisted-labs"
  else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
  fi
else
  ROOT="$LAB_ROOT"
fi
LABS="$ROOT/labs"
NORMAL_STATE_DIR="/workspace/training/.lab-state"
HARDCADE_STATE_DIR="/workspace/training/.hardcade-state"
if [ -f "$HARDCADE_STATE_DIR/active" ]; then
  STATE_DIR="$HARDCADE_STATE_DIR"
  TRAINING_ROOT="/workspace/hardcade-training"
else
  STATE_DIR="$NORMAL_STATE_DIR"
  TRAINING_ROOT="/workspace/training"
fi
export LAB_TRAINING_ROOT="$TRAINING_ROOT"
# Motore VARIANTI HARDCADE: converte il lab in un set di valori per token V_*.
# - BASE (variante 0): i valori canonici del corso.
# - HARDCADE: hc_use_variant <id> <num> sovrascrive per-lab con la variante scelta.
# I token NON vengono esportati globalmente all'avvio (i valori V_* sono
# per-lab e varierebbero il rendering dei lab STANDARD/ARCADE): require_lab
# applica SEMPRE i valori del lab di destinazione (base 0, o la variante se
# HARDCADE), cosi STANDARD/ARCADE e la suite restano IDENTICI a prima.
source "$ROOT/lib/variants.sh"
# Versione del CLI (bin/lab). NON coincide con il numero degli archivi
# `ver NNNN` in ~/Assisted-Labs-Versioni (quelli li gestisce versiona.sh):
# versione del tool `lab`, incrementata a mano quando il CLI subisce
# modifiche sostanziali (finding #6). 2.10: guardia lab check/hint su lab
# non corrente in HARDCADE (F2) + terminologia errori al posto di vite (F1).
# 2.11: la dettatura si supera anche con SPAZIO (oltre che con INVIO), ovunque
# appaia testo dettato (bin/lab e bin/intro.sh).
VERSION="2.11"

# ---------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------
hr()   { printf '%s\n' "----------------------------------------"; }
hdr()  { printf '\n'; hr; printf ' %s\n' "$*"; hr; }
die()  { printf 'ERR: %s\n' "$*" >&2; exit 2; }
ok()   { printf 'OK:  %s\n' "$*"; }
warn() { printf '!!   %s\n' "$*" >&2; }
cmd()  { printf '\033[1;36m%s\033[0m' "$*"; }
# Grassetto neutro (nessun colore): evidenzia i comandi nel menu del benvenuto
# senza confonderli con l'evidenziazione cyan/magenta delle utility e consegne.
bold() { printf '\033[1m%s\033[0m' "$*"; }

# Stampa una riga a 2 colonne: la prima (anche con codici colore ANSI) viene
# allineata a W celle VISIBILI. I codici \033[...m NON contano nella larghezza,
# cosi le colonne restano dritte anche se la cella e colorata.
two_col() {
  local W="$1" left="$2" desc="$3" n pad
  n=$(printf '%s' "$left" | sed -e 's/\x1b\[[0-9;]*m//g' | wc -m)
  pad=$((W - n))
  [ "$pad" -lt 1 ] && pad=1
  printf '  %s%*s %s\n' "$left" "$pad" "" "$desc"
}

# Larghezza di display (colonne terminale) di una stringa. Conta 2 per i
# caratteri "wide" (trattini lunghi, CJK, emoji), 1 per il resto. Cosi la
# cornice resta allineata anche se il testo contiene un em-dash.
disp_w() {
  local s="$1" i ch code w=0
  for (( i = 0; i < ${#s}; i++ )); do
    ch="${s:i:1}"
    code=$(printf '%d' "'$ch")
    if  (( code == 0x2013 || code == 0x2014 || code == 0x2015 )) \
     || (( (code >= 0x1100 && code <= 0x115F)   \
        || (code >= 0x2E80 && code <= 0xA4CF)   \
        || (code >= 0xAC00 && code <= 0xD7A3)   \
        || (code >= 0xF900 && code <= 0xFAFF)   \
        || (code >= 0xFE30 && code <= 0xFE6F)   \
        || (code >= 0xFF00 && code <= 0xFF60)   \
        || (code >= 0xFFE0 && code <= 0xFFE6)   \
        || (code >= 0x1F300 && code <= 0x1F64F) \
        || (code >= 0x1F900 && code <= 0x1F9FF) )); then
      w=$((w + 2))
    else
      w=$((w + 1))
    fi
  done
  printf '%s' "$w"
}

# Box "biglietto da visita" con larghezza interna fissa, coerente col banner.
# Default: box ASCII puro (+, -, |) che si renderizza ovunque. Il box Unicode
# (╔═╗║╚╝) si riattiva forzando ASSISTED_LABS_BANNER_ASCII=0, coerente con
# startup-banner.sh.
if [ "${ASSISTED_LABS_BANNER_ASCII:-1}" = "1" ]; then
  BX_TL='+'; BX_HB='-'; BX_TR='+'; BX_VB='|'; BX_BL='+'; BX_BR='+'
else
  BX_TL='╔'; BX_HB='═'; BX_TR='╗'; BX_VB='║'; BX_BL='╚'; BX_BR='╝'
fi
BOX_W=44
box_top()     { printf '%s' "$BX_TL"; printf '%*s' "$BOX_W" "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_TR"; }
box_mid()     { local t="$1"; local pad=$((BOX_W - $(disp_w "$t"))); printf '%s' "$BX_VB"; printf '%s%*s' "$t" "$pad" ""; printf '%s\n' "$BX_VB"; }
box_bottom()  { printf '%s' "$BX_BL"; printf '%*s' "$BOX_W" "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_BR"; }

# Descrive una sezione del menu di benvenuto: le righe compaiono in lampeggio
# (SGR 5) per LAB_BLINK_SECS secondi, poi tornano stabili (one-shot). Serve a
# catturare l'attenzione sulle descrizioni delle modalita. In non-TTY stampa
# subito il testo stabile SENZA codici ANSI (niente rumore per pipe/suite).
blink_desc() {
  local txt="$1" n
  if [ -t 1 ]; then
    n=$(printf '%b' "$txt" | wc -l)
    printf '\033[5m%b\033[25m' "$txt"
    sleep "${LAB_BLINK_SECS:-1.8}"
    printf '\033[%dA\033[J' "$n"
    printf '%b' "$txt"
  else
    printf '%b' "$txt"
  fi
}

usage() {
  box_top
  box_mid "  lab — Assisted Linux Labs"
  box_bottom
  cat <<'EOF'

USO
  lab <comando> [lab-id] [opzioni]

COMANDI
  list                         elenco esercizi
  start  <lab-id>              reset + mostra consegna (parti da zero)
  task   <lab-id>              mostra consegna SENZA resettare
  check  <lab-id>              valida il lavoro (NON resetta se fallisce)
  hint   <lab-id>              prossimo indizio (uno alla volta)
  -h     [<lab-id>]            alias breve di hint; senza id usa il lab corrente
  hint   <lab-id> --all        tutti gli indizi
  hint   <lab-id> --reset      riparte dagli indizi
  class  <lab-id>              lezione narrata interattiva sugli argomenti
  mode class                  lezioni di TUTTI i lab, in ordine (01 → 10)
  solution <lab-id>            mostra una soluzione possibile
  reset  <lab-id>              ripristina SOLO quel lab
  reset  --all                azzera TUTTI i lab in un colpo
  status                       avanzamento di tutti i lab
  mode   [standard|arcade|hardcade|class] visualizza o cambia modalita (-s/-a/-hc)
  doctor                       diagnosi ambiente
  quit                         chiude la sessione e il terminale
  help|--help                  questo messaggio
  readme                       guida estesa
  anim  <nome>                 anteprima animazioni (lesson, rocket, fireworks, rain, all)

EOF
  cat <<'EOF2'
UTILITY (comandi Linux disponibili nel container)
EOF2
  two_col 30 "$(cmd 'tree') [percorso]" "mostra l'albero di file e directory"
  two_col 30 "$(cmd 'history')" "mostra i comandi eseguiti nella shell"
  two_col 30 "$(cmd 'tail') [-n N] <file>" "mostra le ultime N righe di un file"
  two_col 30 "$(cmd 'tail -f') <file>" "segue nuove righe in tempo reale (Ctrl+C per uscire)"
  two_col 30 "$(cmd '<comando> --help')" "guida rapida integrata (es. ls --help)"
  two_col 30 "$(cmd 'man') <comando>" "manuale completo (es. man cp)"
  cat <<'EOF'

FLUSSO
  1. lab list
  2. lab start 01-filesystem
  3. cd nel WORKDIR indicato e digita i comandi a mano
  4. lab check 01-filesystem
  5. se fallisce: lab hint 01-filesystem  (il lavoro resta intatto)
  6. lab solution 01-filesystem  solo a fine esercizio

NOTE
  - check NON cancella i tuoi file. Solo start/reset lo fanno.
  - -h e la forma breve di hint; l'help si invoca solo con  lab help  o  lab --help.
  - senza id, -h usa il "lab corrente" (l'ultimo lab toccato: start/task/check/...).
  - gli hint vanno dal concetto al comando: parti dal primo, rilancia per il prossimo.
  - dopo un check OK appare il ripasso "PERCHE FUNZIONA".
  - per scrivere testo in un file: printf (preciso) oppure echo (newline finale ok).
  - i file di lavoro vivono nella root della modalita corrente (volume Docker)
  - i lab ufficiali vivono in /opt/assisted-labs     (immagine)
  - i testi scorrono con battitura veloce (0.04 s/car); premi INVIO o SPAZIO
    durante lo scorrimento per mostrare subito il resto del messaggio.
  - le lezioni (lab class / lab mode class) scorrono a 0.03 s/car (LAB_TYPE_CLASS).
  - nelle consegne i comandi Linux sono evidenziati in magenta (ad alto contrasto).

ESEMPI
  lab list
  lab class 01-filesystem
  lab mode class
  lab start 01-filesystem
  lab check 01-filesystem
  lab hint  01-filesystem
EOF
}

ensure_state() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true
}

# Benvenuto breve: mostrato da `lab` senza argomenti. Dettagli su `lab help`.
# Al PRIMO avvio (nessuna modalita scelta) propone un menu per scegliere la lab mode.
welcome() {
  box_top
  box_mid "  Assisted Linux Labs"
  box_mid "  il tuo laboratorio Linux, pronto per te."
  box_bottom
  printf '\n'
  printf 'Sei in una sandbox sicura: sperimenta senza timore.\n'
  printf '\n'

  # Menu di scelta della modalita: disponibile ad OGNI avvio, non solo al primo.
  ensure_state
  local cur_mode="standard"
  if is_hardcade; then cur_mode="hardcade"
  elif is_arcade;  then cur_mode="arcade"; fi
  hdr "SCEGLI LA MODALITA"
  printf 'Modalita attuale: %s\n' "$cur_mode"
  printf 'Puoi cambiarla quando vuoi (anche in seguito con:  lab mode).\n'
  printf '\n'
  local mm="" choices="1/2"
  mm+="  $(cmd '[1] Standard')\n"
  mm+="      Facile, guida passo-passo che tiene per mano.\n"
  mm+="      Tentativi illimitati, indizi gratuiti: ideale per iniziare.\n"
  mm+="\n"
  mm+="  $(cmd '[2] Arcade')\n"
  mm+="      Sfida a 3 vite con timer, indizi limitati (lampadine) e ostacoli.\n"
  mm+="\n"
  if is_hardcade || arcade_easter_unlocked || [ "${LAB_EH_UNLOCK:-}" = "1" ]; then
    mm+="  $(cmd '[3] Hardcade')\n"
    mm+="      Sfida segreta a 3 errori condivisi: varianti diverse a ogni run,\n"
    mm+="      si sblocca con una run ARCADE perfetta (tutti i lab, 0 vite perse).\n"
    mm+="\n"
    choices="1/2/3"
  fi
  blink_desc "$mm"
  printf '  [invio] = mantieni la modalita attuale (%s)\n' "$cur_mode"
  printf 'Scegli [%s, invio = mantieni] > ' "$choices"
  local scelta
  read -r scelta || scelta=""
  case "${scelta:-keep}" in
    keep|"")
      ok "Modalita invariata: $cur_mode"
      ;;
    2|arcade|Arcade|ARCADE)
      if is_hardcade; then
        warn "Sei in HARDCADE: non puoi cambiare modalita qui."
        printf 'Per uscire da HARDCADE:  lab mode standard --exit\n\n'
      else
        echo "arcade" > "$NORMAL_STATE_DIR/mode"
        echo 1 > "$NORMAL_STATE_DIR/mode-chosen"
        ok "Modalita impostata su ARCADE"
      fi
      ;;
    3|hardcade|Hardcade|HARDCADE)
      if is_hardcade; then
        ok "Resti in HARDCADE"
      elif ! arcade_easter_unlocked && [ "${LAB_EH_UNLOCK:-}" != "1" ]; then
        hardcade_refuse
      else
        mkdir -p "$HARDCADE_STATE_DIR"
        echo 1 > "$HARDCADE_STATE_DIR/active"
        echo 0 > "$HARDCADE_STATE_DIR/errors"
        STATE_DIR="$HARDCADE_STATE_DIR"
        echo 1 > "$HARDCADE_STATE_DIR/mode-chosen"
        ok "Modalita impostata su HARDCADE"
      fi
      ;;
    *|1|standard|std|classic|relax)
      if is_hardcade; then
        warn "Sei in HARDCADE: non puoi cambiare modalita qui."
        printf 'Per uscire da HARDCADE:  lab mode standard --exit\n\n'
      else
        echo "standard" > "$NORMAL_STATE_DIR/mode"
        echo 1 > "$NORMAL_STATE_DIR/mode-chosen"
        ok "Modalita impostata su STANDARD"
      fi
      ;;
  esac
  printf '\n'

  two_col 16 "$(bold 'lab')"            "Apri questo menu (possibilità)"
  two_col 16 "$(bold 'lab list')"       "Cosa posso fare qui"
  two_col 16 "$(bold 'lab start <id>')" "Parti il primo esercizio"
  two_col 16 "$(bold 'lab check <id>')" "Verifica il lavoro [non cancella nulla]"
  two_col 16 "$(bold 'lab hint <id>')"  "Un indizio se ti blocchi"
  two_col 16 "$(bold 'lab mode')"       "Cambia modalita (standard · arcade · class)"
  two_col 16 "$(bold 'lab class <id>')" "Lezione narrata di un singolo lab"
  two_col 16 "$(bold 'lab mode class')" "Lezioni di tutti i lab, in ordine (01 → 10)"
  printf '\n'
  printf '  Prima cosa da fare:   lab list\n'
  printf '  Tutti i comandi:      lab help\n'
  printf '\n'
}

lab_ids() {
  find "$LABS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# Larghezza colonna TEMA: serve abbastanza spazio per il tema piu lungo
# (08-system-admin=44 su Alpine) senza troncare "logger" ne lasciare virgole sospese.
MAX_THEME_W=48

theme_col_width() {
  local max=4 id t
  for id in $(lab_ids); do
    t=$(cat "$LABS/$id/theme.txt" 2>/dev/null || printf '%s' "-")
    if [ "${#t}" -gt "$max" ]; then
      max="${#t}"
    fi
  done
  if [ "$max" -gt "$MAX_THEME_W" ]; then
    max="$MAX_THEME_W"
  fi
  printf '%s' "$max"
}

# Tronca il tema alla larghezza di colonna per evitare tabelle storte.
theme_str() {
  printf '%s' "$1" | cut -c1-"$MAX_THEME_W"
}

require_lab() {
  if [ "$#" -lt 1 ] || [ -z "${1:-}" ]; then
    die "manca lab-id. Prova: lab list"
  fi
  local id="$1"
  if ! [[ "$id" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    die "lab-id non valido: $id (usa solo lettere, numeri, '_' e '-')"
  fi
  LAB="$LABS/$id"
  LAB_ID="$id"
  if [ ! -d "$LAB" ]; then
    warn "lab sconosciuto: $id"
    printf 'lab disponibili:\n' >&2
    lab_ids | sed 's/^/  /' >&2
    exit 2
  fi
  # Token V_* APPLICATI SEMPRE per-lab: in HARDCADE la variante scelta (0 = base),
  # altrimenti la BASE canonica. Nessun export globale: il lab di destinazione
  # decide i propri valori, quindi STANDARD/ARCADE restano identici a prima.
  if is_hardcade; then
    hc_use_variant "$id" "$(hc_variant "$id")"
  else
    hc_use_variant "$id" 0
  fi
  # Lab "corrente": l'ultimo lab toccato dall'utente. Permette a `lab -h`
  # (senza id) di indovinare su quale lab richiedere gli indizi.
  ensure_state
  printf '%s' "$LAB_ID" > "$STATE_DIR/current-lab" 2>/dev/null || true
}

# Markdown → testo TTY: toglie fence/grassetto/backtick, ma non tocca
# il contenuto dei blocchi codice (es. "# build" resta "# build").
print_plain_md() {
  awk '
    function strip_inline(s) {
      while (match(s, /`[^`]+`/)) {
        s = substr(s, 1, RSTART-1) substr(s, RSTART+1, RLENGTH-2) substr(s, RSTART+RLENGTH)
      }
      while (match(s, /\*\*[^*]+\*\*/)) {
        s = substr(s, 1, RSTART-1) substr(s, RSTART+2, RLENGTH-4) substr(s, RSTART+RLENGTH)
      }
      return s
    }
    BEGIN { in_code = 0 }
    /^```/ { in_code = !in_code; next }
    {
      if (in_code) { print; next }
      sub(/^#{1,6}[[:space:]]+/, "")
      print strip_inline($0)
    }
  '
}

# Evidenziazione in MAGENTA BOLD dei comandi Linux nel testo delle consegne.
# Wrappa le parole chiave del corso in \033[1;35m ... \033[0m cosi l'utente le
# nota subito (alto contrasto, nessun conflitto con i colori UI: verde/blu/cyan).
highlight_cmds() {
  # I codici colore sono passati con -v (virgolette doppie): non incrociano
  # gli apici singoli dello script awk e il $'...' genera il carattere ESC.
  local MAG=$'\033[1;35m' RST=$'\033[0m'
  awk -v MAG="$MAG" -v RST="$RST" '
    # Le parole comuni dei commenti italiani fermano il colore del comando,
    # cosi restano in chiaro (es. "il flag -p crea anche ... " dopo mkdir).
    function is_stop(t,   sw, n, i) {
      n = split("il lo la i gli le un uno una di da del della dei delle e ed o a \
                 al alla ai ale in con su per tra fra che chi come cosa quando dove \
                 non si ci vi mi ti crea creare creando aggiunge aggiungono rende \
                 imposta setta toglie copia sposta elimina avvia mostra verifica \
                 file files directory dir cartella cartelle testo stringa riga \
                 righe contenuto permessi modo modalita lab corso esercizio", sw, " ")
      for (i = 1; i <= n; i++) if (sw[i] == t) return 1
      return 0
    }
    function is_cmd(t, nx,   subs, n2, i2, cmds, n, i) {
      # Un token che termina con ":" e una spiegazione, non un comando (mkdir:).
      if (t ~ /:$/) return 0
      # "lab" e anche una parola dei commenti ("questo lab"); e un comando del
      # corso SOLO quando e seguito da un subcomando della CLI (lab start...).
      if (t == "lab") {
        n2 = split("start check hint list task reset solution mode status doctor help quit", subs, " ")
        for (i2 = 1; i2 <= n2; i2++) if (subs[i2] == nx) return 1
        return 0
      }
      # NB: "file", "type", "vi" sono ESCLUSI: parole italiane comuni nei
      # commenti ("un file", "tipo") causerebbero falsi positivi.
      n = split("mkdir rmdir chmod chown chgrp mv cp rm ls touch cat less tail head \
                 grep egrep fgrep sed awk sort uniq wc diff cmp comm find locate \
                 cd pwd sudo su echo printf df du tar gzip gunzip zip unzip \
                 ssh scp rsync ping curl wget ip ss ps top free logger \
                 crontab stat lsof which tree man nano vim env set \
                 export history tee xargs tr cut paste join", cmds, " ")
      for (i = 1; i <= n; i++) if (cmds[i] == t) return 1
      return 0
    }
    # Un token e un "argomento plausible" del comando (flag, path, valore...).
    function is_arg(t) {
      if (t ~ /^-/)        return 1          # flag: -p, --recursive, a+x
      if (t ~ /\// || t ~ /\./ || t ~ /~/ )  return 1   # path: project/docs, data.txt
      if (t ~ /^[0-9]/)    return 1          # numerico: 600, 775, 500
      if (t ~ /^[\x27"\$%<>\|]/) return 1    # quote, $var, redirect, pipe, <modo>
      return 0
    }
    function hilite(line,   out, i, j, k, w, n, str, parts, inq) {
      n = split(line, parts, " ")
      out = ""
      for (i = 1; i <= n; i++) {
        w = parts[i]
        if (w != "" && is_cmd(w, parts[i+1])) {
          # Trova la fine del comando: gli argomenti plausibili continuano,
          # le stop-words italiane e i ":" lo fermano. Le stringhe quota
          # (apici/virgolette) vengono consumate intere anche su piu parole.
          inq = 0
          j = i + 1
          while (j <= n) {
            t = parts[j]
            if (inq) {
              if (t ~ /\x27$/ || t ~ /"$/) inq = 0
              j++
              continue
            }
            if (t ~ /^[\x27"]/) { inq = 1; j++; continue }
            if (t == ":" || t ~ /:$/ || is_stop(t)) break
            j++
          }
          str = ""
          for (k = i; k < j; k++) str = str (k > i ? " " : "") parts[k]
          out = out (i > 1 ? " " : "") MAG str RST
          i = j - 1
        } else {
          out = out (i > 1 ? " " : "") w
        }
      }
      return out
    }
    {
      if ($0 ~ /\033\[[0-9;]*m/) { print; next }
      print hilite($0)
    }
  '
}

# Cerca il prossimo .!?, in $a partendo da indice $from.
# Stampa (stdout) tutto fino a inclusa quella punteggiatura e salva il nuovo
# indice in $tw_skip_idx. NON usare command substitution sul ritorno: la
# chiamata `out=$(...)` catturerebbe anche il testo (bug R1 ritest) e lo
# inghiottirebbe invece di mostrarlo a terminale.
tw_skip_idx=0
typewrite_skip_to_sentence() {
  local a="$1" from="$2" j
  for (( j=from; j<${#a}; j++ )); do
    case "${a:j:1}" in
      [.!?!])
        printf '%s' "${a:from:j+1}"
        tw_skip_idx=$((from + j + 1))
        return
        ;;
    esac
  done
  printf '%s' "${a:from}"
  tw_skip_idx=${#a}
}

# --- Dettatura "solo INVIO o SPAZIO". Durante la battitura l'utente NON deve
# poter digitare niente altro che INVIO o SPAZIO: entrambi completano subito
# la frase corrente; ogni altro tasto viene scartato senza eco e senza effetto
# (non fa saltare la battitura) e non resta in coda per i menu o i prompt
# successivi. Il terminale passa a modalita' non canonica senza echo (stty),
# con ripristino garantito anche su Ctrl-C (stesso schema delle animazioni).
TW_TTY_RAW=0
TW_STTY_SAVED=""
tw_trap() {
  if [ "${TW_TTY_RAW:-0}" = "1" ] && [ -n "${TW_STTY_SAVED:-}" ]; then
    stty "$TW_STTY_SAVED" </dev/tty 2>/dev/null || true
    TW_TTY_RAW=0
  fi
  trap - INT TERM EXIT
}
tw_interrupt() {
  tw_trap
  exit 130
}
tw_raw_on() {
  [ -t 1 ] || return 1
  TW_STTY_SAVED="$(stty -g </dev/tty 2>/dev/null)" || { TW_STTY_SAVED=""; return 1; }
  stty -icanon -echo </dev/tty 2>/dev/null || { TW_STTY_SAVED=""; return 1; }
  TW_TTY_RAW=1
  trap 'tw_interrupt' INT TERM
  trap 'tw_trap' EXIT
  return 0
}
tw_raw_off() {
  [ -t 1 ] || return 0
  tw_trap
  return 0
}
# tw_enter <secondi> — attende per <secondi> (accetta decimali) che l'utente
# prema INVIO o SPAZIO. Ritorna 0 se arriva SOLO INVIO o SPAZIO entro la
# finestra, 1 se scade. Ogni altro tasto viene letto e scartato subito: non
# compare a schermo e non interrompe la dettatura.
tw_enter() {
  local win="$1" c k iters
  iters="$(awk -v w="$win" 'BEGIN{printf "%d", (w/0.01)+1}')"
  for (( k=0; k<iters; k++ )); do
    if IFS= read -r -s -n1 -t 0.01 c </dev/tty 2>/dev/null; then
      case "$c" in
        $'\n'|$'\r'|' ') return 0 ;;
      esac
    fi
  done
  return 1
}
# tw_flush — consuma l'input rimasto in coda (es. INVIO/SPAZIO tenuto premuto o
# tasti digitati a schermo pieno) prima di uscire dalla dettatura: nulla deve
# finire nei menu o nel prompt successivi.
tw_flush() {
  local c
  while IFS= read -r -s -n1 -t 0.02 c </dev/tty 2>/dev/null; do :; done
  return 0
}

# Consegna in testo grezzo (niente markdown spezzato).
# Battitura lettera per lettera SOLO su terminale. Di default veloce (0.04
# s/car); se l'utente preme INVIO o SPAZIO durante lo scorrimento mostra il
# testo fino al prossimo .!?, e infonde un ritmo da "dettatura": pausa lunga
# dopo .!? (LAB_PAUSE_SENTENCE, default 0.4s) e pausa breve dopo ,;:
# (LAB_PAUSE_COMMA, default 0.15s). Durante la dettatura i soli tasti con
# effetto sono INVIO e SPAZIO (completano subito la frase corrente); ogni
# altro tasto viene scartato senza eco e senza residui. Se LAB_INSTANT_RENDER=1
# (salvaguardia arcade/hardcade) la stampa e' istantanea. Negli ambienti
# non-TTY (suite, pipe, CI) stampa subito.
typewrite() {
  local line speed i c
  local pause_sentence="${LAB_PAUSE_SENTENCE:-0.4}"
  local pause_comma="${LAB_PAUSE_COMMA:-0.15}"
  speed="${LAB_TYPE_NARR:-0.04}"
  # Colore della voce narrante. Due modi:
  #   - LAB_TYPE_SPEAKER (es. "Root"): il personaggio che parla. Stampa
  #     l'etichetta "<SPEAKER>:" in giallo opaco seguita dal testo del dialogo
  #     nel colore normale ("Root: un'identita' tutta tua...").
  #   - LAB_TYPE_COLOR (es. 33): colora l'INTERA riga con quell'ANSI (vecchio
  #     comportamento, usato dove la riga non e' un dialogo).
  # Default: nessun colore (comportamento storicamente invariato).
  local c_in c_out
  local tcol="${LAB_TYPE_COLOR:-}"
  local spk="${LAB_TYPE_SPEAKER:-}"
  if [ -n "$spk" ]; then
    c_in=$'\033[33m'"${spk}:"$'\033[0m '
    c_out=""
  elif [ -n "$tcol" ]; then c_in=$'\033['"${tcol}m"; c_out=$'\033[0m'
  else c_in=""; c_out=""; fi
  if [ "${1:-}" = "-c" ]; then
    speed="${LAB_TYPE_CMD:-0.04}"
    shift || true
  fi

  # Su terminale la dettatura e' interattiva ("INVIO o SPAZIO completano");
  # altrove si stampa tutto subito senza toccare il terminale.
  local tty_mode=0
  if [ -t 1 ] && [ "${LAB_INSTANT_RENDER:-0}" != "1" ] && [ "$speed" != "0" ]; then
    if tw_raw_on; then tty_mode=1; fi
  fi

  while IFS= read -r line; do
    if [ "$tty_mode" = "1" ]; then
      printf '%s' "$c_in"
      for (( i=0; i<${#line}; i++ )); do
        printf '%s' "${line:i:1}"
        c="${line:i:1}"
        # Pausa per punteggiatura: . ! ? → pausa piu lunga; , ; : → pausa breve.
        # In entrambe INVIO o SPAZIO completano subito la frase corrente.
        case "$c" in
          [.!?!])
            if tw_enter "$pause_sentence"; then
              typewrite_skip_to_sentence "$line" "$((i+1))"
              break
            fi
            ;;
          [,\;:])
            if tw_enter "$pause_comma"; then
              typewrite_skip_to_sentence "$line" "$((i+1))"
              break
            fi
            ;;
        esac
        # Finestra standard tra un carattere e il successivo: INVIO o SPAZIO
        # completano subito la frase corrente.
        if tw_enter "$speed"; then
          typewrite_skip_to_sentence "$line" "$((i+1))"
          break
        fi
      done
      printf '\n%s' "$c_out"
    else
      printf '%s%s%s\n' "$c_in" "$line" "$c_out"
    fi
  done

  if [ "$tty_mode" = "1" ]; then
    tw_flush
    tw_raw_off
  fi
  return 0
}
# footer_line <comando> <commento> — riga dei COMANDI UTILI con i '#' allineati
# a colonna fissa. Il padding e' calcolato sulla lunghezza VISIBILE del comando
# (ignora l'ANSI di cmd()), altrimenti i '#' finiscono a colonne diverse.
footer_line() {
  local c="$1" cmt="$2" pad
  pad=$(( 33 - 2 - ${#c} - 1 - ${#LAB_ID} ))
  [ "$pad" -lt 1 ] && pad=1
  printf '  %s %s%*s# %s\n' "$(cmd "$c")" "$LAB_ID" "$pad" "" "$cmt" | typewrite -c
}

print_task() {
  local f="$LAB/README.md"
  local training_placeholder='${LAB_TRAINING_ROOT:-/workspace/training}'
  if [ ! -f "$f" ]; then
    die "manca README per $LAB_ID"
  fi
  hdr "LAB  $LAB_ID"
  local body
  body=$(sed -e "s#${training_placeholder}#$TRAINING_ROOT#g" "$f")
  printf '%s' "$body" | hc_render_text | print_plain_md | highlight_cmds | typewrite
  printf '\n'
  printf 'COMANDI UTILI\n' | typewrite -c
  footer_line 'lab task'  'rivedi consegna'
  footer_line 'lab check' 'valida (non resetta)'
  footer_line 'lab hint'  'indizio successivo'
  footer_line 'lab reset' 'azzera SOLO questo lab'
  printf '\n'
}

safe_cwd() {
  # Evita getcwd errors se l'utente era dentro una dir cancellata dal reset.
  cd /workspace 2>/dev/null || cd / 2>/dev/null || true
}

MAX_LIVES=3

is_arcade() {
  [ "$STATE_DIR" = "$HARDCADE_STATE_DIR" ] && return 1
  if [ -f "$STATE_DIR/mode" ]; then
    [ "$(cat "$STATE_DIR/mode")" = "arcade" ]
  else
    [ "${LAB_MODE:-standard}" = "arcade" ]
  fi
}

is_hardcade() { [ "$STATE_DIR" = "$HARDCADE_STATE_DIR" ]; }

is_standard() { ! is_arcade && ! is_hardcade; }

# ---------------------------------------------------------------------------
# Easter egg HARDCADE: si sblocca solo con una run ARCADE perfetta
# (tutti i lab completati senza mai perdere una vita).
# ---------------------------------------------------------------------------
ARCADE_PERFECT_FILE="$NORMAL_STATE_DIR/arcade-perfect"

all_labs_done() {
  local id
  for id in $(lab_ids); do
    [ -f "$STATE_DIR/done-$id" ] || return 1
  done
  return 0
}

# 1 = la carriera arcade non ha mai perso una vita; 0 o assente = no.
arcade_perfect() {
  [ -f "$ARCADE_PERFECT_FILE" ] && [ "$(cat "$ARCADE_PERFECT_FILE")" = "1" ]
}

set_arcade_perfect() { ensure_state; echo "$1" > "$ARCADE_PERFECT_FILE"; }

# --- Statistiche di gioco: streak lab puliti + contatore usi hint (per lab). ---
ARCADE_STREAK_FILE="$NORMAL_STATE_DIR/arcade-streak"

arcade_streak() {
  [ -f "$ARCADE_STREAK_FILE" ] && cat "$ARCADE_STREAK_FILE" || echo 0
}

set_arcade_streak() { ensure_state; echo "$1" > "$ARCADE_STREAK_FILE"; }

arcade_hint_uses() {
  local f="$NORMAL_STATE_DIR/hint-uses-$1"
  [ -f "$f" ] && cat "$f" || echo 0
}

set_arcade_hint_uses() { ensure_state; echo "$2" > "$NORMAL_STATE_DIR/hint-uses-$1"; }

# Un messaggio casuale tra 5 per celebrare una streak di lab puliti.
arcade_streak_message() {
  local msgs=(
    'Avanti così!'
    'Tieni duro, stai andando benissimo.'
    'Ritmo perfetto: continua così.'
    'Ottimo lavoro, la costanza paga.'
    'Sei in forma, non fermarti ora.'
  )
  local idx=$((RANDOM % ${#msgs[@]}))
  printf '%s\n' "${msgs[idx]}"
}

# In ARCADE ogni 2 usi di hint per-lab costa 1 cuore (contatore hint-uses-<id>).
arcade_hint_penalty() {
  local id="$1"
  local u
  u=$(arcade_hint_uses "$id")
  u=$((u + 1))
  set_arcade_hint_uses "$id" "$u"
  if [ $((u % 2)) -eq 0 ]; then
    local lives
    lives=$(get_lives "$id")
    if [ "$lives" -gt 0 ]; then
      lives=$((lives - 1))
      set_lives "$id" "$lives"
      warn "hai accumulato 2 indizi in questo lab: -1 vita!"
      printf 'Vite attuali: %s\n\n' "$(render_lives "$lives")"
      set_arcade_perfect 0   # anche l'abuso di indizi invalida la run perfetta
    fi
  fi
}

# --- Easter egg HARDCADE: aiuto (hint/solution) OTK per lab. ---
# La PRIMA consultazione di hint o solution in un lab costa 1 errore, parte la
# cascata e l'help resta disabilitato per quel lab (file help-used-<id>).
hardcade_help_used() {
  [ -f "$HARDCADE_STATE_DIR/help-used-$LAB_ID" ]
}

hardcade_use_help() {
  ensure_state
  if hardcade_help_used; then
    hdr "AIUTO BLOCCATO"
    printf 'L aiuto per questo lab e gia stato consumato.\n'
    printf 'Prova a risolvere da solo.\n\n'
    return 1
  fi
  echo 1 > "$HARDCADE_STATE_DIR/help-used-$LAB_ID"
  ascii_rain
  local errors used
  errors=$(hardcade_errors)
  used=$((errors + 1))
  echo "$used" > "$HARDCADE_STATE_DIR/errors"
  if [ "$used" -ge 3 ]; then
    warn "AIUTO CONSUMATO — terzo errore: HARDCADE GAME OVER"
    hardcade_game_over
  fi
  warn "AIUTO CONSUMATO — errore HARDCADE $used/3"
  printf 'Errori rimasti: %s\n' "$(render_hardcade_errors)"
  printf 'Per questo lab l aiuto ora e disabilitato.\n\n'
  return 0
}

# Sbloccata solo se: siamo in arcade, run perfetta e tutta completata.
arcade_easter_unlocked() {
  is_arcade && arcade_perfect && all_labs_done
}

hardcade_errors() {
  [ -f "$HARDCADE_STATE_DIR/errors" ] && cat "$HARDCADE_STATE_DIR/errors" || echo 0
}

# Errori rimasti in HARDCADE (3 errori condivisi per sessione):
# ⚪ = errore ancora disponibile, ❌ = errore gia' consumato.
# Larghezza celle identica a render_lives (2 celle + spazio) per non
# spostare la colonna TEMA nelle tabelle (finding F1).
render_hardcade_errors() {
  local errors remaining
  errors="$(hardcade_errors)"
  remaining=$((3 - errors))
  [ "$remaining" -lt 0 ] && remaining=0
  render_hardcade_errors_cells "$remaining" 3
}

render_hardcade_errors_cells() {
  local count="$1" max="${2:-3}" i str=""
  for ((i=1; i<=max; i++)); do
    if [ "$i" -le "$count" ]; then
      str="${str}⚪ "
    else
      str="${str}❌ "
    fi
  done
  printf '%s [%d/%d]' "$str" "$count" "$max"
}

# ---------------------------------------------------------------------------
# MOTORE VARIANTI HARDCADE (WP3)
# ---------------------------------------------------------------------------
# Variante assegnata a un lab in una run hardcade (1..N) o 0 = BASE.
hc_variant() {
  local id="$1"
  if [ -f "$HARDCADE_STATE_DIR/variant-$id" ]; then
    cat "$HARDCADE_STATE_DIR/variant-$id"
  else
    echo 0
  fi
}

# hc_use_variant <lab-id> <num> — esporta i valori V_* della variante scelta.
# 0 = BASE canonica (idem standard/arcade). In HARDCADE il CLI lo chiama da
# require_lab/hc_enter/hc_advance per ogni lab.
hc_use_variant() {
  local id="$1" num="${2:-0}"
  eval "$(hcv_values "$id" "$num")"
}

# Rende un testo sostituendo i token @V_X@ con i valori correnti. Usato sui
# testi README/hint/why che devono riflettere la variante attiva.
variant_render() {
  local text="$1"
  local out="$text" var val
  while IFS= read -r var; do
    val="${!var:-}"
    [ -n "$val" ] || continue
    out="${out//@$var@/$val}"
  done < <(compgen -v | grep '^V_' || true)
  printf '%s' "$out"
}

# hc_render_text — come variant_render ma come FILTRO su stdin (per pipe).
hc_render_text() {
  variant_render "$(cat)"
}

# hc_render <file> — rende un file di testo (README/hint/why) con la variante |
# oppure, in hardcade, crea una copia renderizzata in $HARDCADE_STATE_DIR/render/
# e stampa la via (per non riposizionare i dati). In standard/arcade stampa la
# via originale (nessuna sostituzione: i file base non hanno token @V_@).
hc_render() {
  local file="$1"
  if ! is_hardcade; then
    printf '%s' "$file"
    return
  fi
  local rendered="$HARDCADE_STATE_DIR/render/$(basename "$file")"
  variant_render "$(cat "$file")" > "$rendered"
  printf '%s' "$rendered"
}

# Riga "posizione di lavoro" (path del lab) resa con la variante attiva.
WORKDIR_HINT='${LAB_TRAINING_ROOT:-/workspace/training}'

# Ordine lab di una run hardcade: shuffle (01..10), salvato in $HARDCADE_STATE_DIR/order.
hc_shuffle() {
  local ids=() id out=() i j tmp
  while IFS= read -r id; do ids+=("$id"); done < <(lab_ids)
  local n=${#ids[@]}
  for (( i = 0; i < n; i++ )); do out[$i]="${ids[$i]}"; done
  for (( i = n - 1; i > 0; i-- )); do
    j=$(( RANDOM % (i + 1) ))
    tmp="${out[$i]}"; out[$i]="${out[$j]}"; out[$j]="$tmp"
  done
  printf '%s ' "${out[@]}"
}

# Variante per lab (una sola scelta a run), persistita in variant-<id>.
hc_choose_variant() {
  local id="$1"
  if [ -f "$HARDCADE_STATE_DIR/variant-$id" ]; then
    cat "$HARDCADE_STATE_DIR/variant-$id"
  else
    local num
    num=$(hcv_pick "$id")
    echo "$num" > "$HARDCADE_STATE_DIR/variant-$id"
    printf '%s' "$num"
  fi
}

# hc_enter — all'avvio di una run HARDCADE: ordina, pesca varianti e parte
# subito col primo lab (reset + consegna). Attiva le V_* per quel lab.
hc_enter() {
  ensure_state
  local order
  order=$(hc_shuffle)
  echo "$order" > "$HARDCADE_STATE_DIR/order"
  echo "1" > "$HARDCADE_STATE_DIR/pos"
  local id num
  # presente = prima voce dell'ordine
  id=$(printf '%s' "$order" | awk '{print $1}')
  num=$(hc_choose_variant "$id")
  hc_use_variant "$id" "$num"
  hdr "HARDCADE — lab 1"
  printf 'Ordine di questa run (varianti diverse a ogni run):\n  %s\n\n' "$(printf '%s '  $(cat "$HARDCADE_STATE_DIR/order"))"
  printf 'Variante attiva per %s: %s\n\n' "$(bold "$id")" "$num"
  cmd_start "$id"
}

# hc_next — primo lab dell'ordine NON ancora completato; vuoto = tutti fatti.
hc_next() {
  local id
  for id in $(cat "$HARDCADE_STATE_DIR/order" 2>/dev/null || true); do
    if [ ! -f "$HARDCADE_STATE_DIR/done-$id" ]; then
      printf '%s' "$id"
      return
    fi
  done
}

# hc_advance — dopo un check OK, avanza automaticamente al prossimo lab (reset+
# consegna) oppure dichiara VITTORIA della run quando non resta alcun lab.
hc_advance() {
  local nxt
  nxt=$(hc_next)
  if [ -z "$nxt" ]; then
    # Tutti i lab completati: vittoria.
    hdr "HARDCADE — RUN COMPLETATA"
    printf 'Hai completato tutti i lab di questa run HARDCADE!\n'
    printf 'Impossibile avere una percentuale di errori: 0 errori in %s lab.\n' "$(wc -w < "$HARDCADE_STATE_DIR/order")"
    printf 'Modalita HARDCADE superata con brio.\n\n'
    return 0
  fi
  local num
  num=$(hc_choose_variant "$nxt")
  hc_use_variant "$nxt" "$num"
  hdr "HARDCADE — prossimo lab"
  printf 'Variante attiva per %s: %s\n\n' "$(bold "$nxt")" "$num"
  cmd_start "$nxt"
}

hardcade_banner() {
  printf '\n'
  printf '%s' "$BX_TL"; printf '%*s' 38 "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_TR"
  printf '%s              GAME OVER               %s\n' "$BX_VB" "$BX_VB"
  printf '%s' "$BX_BL"; printf '%*s' 38 "" | tr ' ' "$BX_HB"; printf '%s\n' "$BX_BR"
  sleep 0.25
  printf '\r              G A M E   O V E R       '
  sleep 0.25
  printf '\r              G A M E   O V E R       \n\n'
}

hardcade_game_over() {
  local id
  for id in $(lab_ids); do
    bash "$LABS/$id/reset.sh" >/dev/null 2>&1 || true
  done
  rm -f "$HARDCADE_STATE_DIR/done-"* "$HARDCADE_STATE_DIR/hint-"* \
        "$HARDCADE_STATE_DIR/lives-"* "$HARDCADE_STATE_DIR/errors" \
        "$HARDCADE_STATE_DIR/help-used-"* "$HARDCADE_STATE_DIR/mode-chosen" \
        "$HARDCADE_STATE_DIR/active"
  rmdir "$HARDCADE_STATE_DIR" 2>/dev/null || true
  hardcade_banner
  printf 'La sessione HARDCADE e i suoi progressi sono stati azzerati.\n'
  printf 'ATTENZIONE: se avevi gia risolto qualche esercizio, il lavoro valido\n'
  printf 'viveva su un salvataggio separato: i tuoi lab STANDARD/ARCADE restano\n'
  printf 'intatti. HARDCADE si chiude qui: il prossimo lab parte nella tua\n'
  printf 'modalita precedente (STANDARD o ARCADE). Per riprovare la sfida:\n'
  printf '  lab mode hardcade --force\n\n'
  exit 42
}

# --- Animazioni: schermata dedicata e ripristino sicuro del terminale.
# Le animazioni disegnano sullo "schermo alternato": all'ingresso si salva la
# schermata del prompt (quella reale) e si disegna su un buffer separato;
# all'uscita quel buffer viene buttato e torna identico il prompt. Cosi non
# resta MAI sporcizia sul terminale vero. Un trap ripristina cursore e buffer
# anche se l'utente interrompe (Ctrl-C) nel bel mezzo dell'animazione.
anim_trap() {
  printf '\033[0m\033[?25h\033[?1049l'   # attributi normali, cursore visibile, esci dal buffer alternato
  trap - INT TERM EXIT
}
# Ripristino forzato su Ctrl-C (SIGINT/SIGTERM): ripristina il terminale e SI
# ESCE subito, cosi l'animazione non continua a ridisegnare sulla schermata
# reale appena ripristinata (che lascerebbe residui).
anim_interrupt() {
  anim_trap
  exit 130
}
anim_enter() {
  [ -t 1 ] || return 1
  printf '\033[?1049h\033[2J\033[H\033[?25l'   # entra nel buffer alternato, pulisci, nascondi cursore
  trap 'anim_interrupt' INT TERM
  trap 'anim_trap' EXIT
  return 0
}
anim_leave() {
  [ -t 1 ] || return 0
  anim_trap
  return 0
}

# Cascata "Matrix" pulita, usata come intro dell'easter egg HARDCADE.
# Cornice, titolo e gocce verticali a "streak" che cadono, disegnate sul buffer
# alternato con cancelletto della coda a ogni frame (niente residui).
# Viene saltata se non c'e un terminale (output reindirizzato o make test).
ascii_rain() {
  [ -t 1 ] || return 0
  local cols rows x y h ny len head tail inner_top inner_bot drop_cells
  cols=$(tput cols 2>/dev/null || echo 80)
  rows=$(tput lines 2>/dev/null || echo 24)
  cols=$((cols > 30 ? cols : 80))
  rows=$((rows > 12 ? rows : 24))
  local inner_top=3
  local inner_bot=$((rows - 2))

  anim_enter || return 0
  # Cornice verde scuro.
  printf '\033[%d;1H\033[32m┌%s┐\033[0m' 1 "$(printf '─%.0s' $(seq 1 $((cols - 2))))"
  printf '\033[%d;1H\033[32m└%s┘\033[0m' "$rows" "$(printf '─%.0s' $(seq 1 $((cols - 2))))"
  for r in $(seq 2 $((rows - 1))); do
    printf '\033[%d;1H\033[32m│\033[0m' "$r"
    printf '\033[%d;%dH\033[32m│\033[0m' "$r" "$cols"
  done
  # Titolo dentro la cornice.
  local title='M A T R I X   R A I N'
  local tx=$(((cols - ${#title}) / 2))
  [ "$tx" -lt 1 ] && tx=1
  printf '\033[%d;%dH\033[1;32m%s\033[0m' "$inner_top" "$tx" "$title"

  # Gocce verticali: una per colonna, ognuna con testa █ e coda ▓░ che cadono.
  # A ogni frame si cancella la cella appena oltre la coda, cosi la goccia
  # "scorre" pulita senza lasciare tracce accumulate.
  local ncol run frame len x
  ncol=$((cols - 6)); [ "$ncol" -lt 1 ] && ncol=1
  run=$((rows * 2))
  for frame in $(seq 1 "$run"); do
    for ((x = 3; x <= cols - 3; x += 2)); do
      len=$((3 + RANDOM % 4))
      y=$(( inner_top + 2 + ((frame + x) % (inner_bot - inner_top - 2)) ))
      [ "$y" -lt $((inner_top + 1)) ] && y=$((inner_top + 1))
      [ "$y" -gt $((inner_bot - 1)) ] && y=$((inner_bot - 1))
      # cancella la cella appena sotto la coda (frame pulito)
      ny=$((y - len - 1))
      if [ "$ny" -ge $((inner_top + 1)) ]; then
        printf '\033[%d;%dH\033[0m \033[0m' "$ny" "$x"
      fi
      # testa luminosa
      printf '\033[%d;%dH\033[1;9%dm█\033[0m' "$y" "$x" "$((2 + RANDOM % 8))"
      for h in $(seq 1 "$len"); do
        ny=$((y - h))
        [ "$ny" -lt $((inner_top + 1)) ] && break
        ch='░'; [ "$h" -eq 1 ] && ch='▓'
        printf '\033[%d;%dH\033[0;3%dm%s\033[0m' "$ny" "$x" "$((2 + RANDOM % 8))" "$ch"
      done
    done
    sleep 0.035
  done

  # Dissolvenza finale: spegni gradualmente le colonne.
  for f in $(seq 1 3); do
    for x in $(seq 3 $((cols - 2))); do
      printf '\033[%d;%dH\033[0m \033[0m' "$((inner_top + RANDOM % (inner_bot - inner_top)))" "$x"
    done
    sleep 0.06
  done

  anim_leave
}

# Fuochi d'artificio ASCII animati, mostrati al completamento di tutti i lab.
# Quattro fasi: lancio dei razzi (dal basso verso l'alto con scia di scintille),
# esplosioni in raggiera radiale simmetrica, pioggia di confetti, banner n/n.
# Colori: rosso(31) verde(32) giallo(33) blu(34) magenta(35) ciano(36).
ascii_fireworks() {
  [ -t 1 ] || return 0
  anim_enter || return 0
  local cols rows f i x y dx dy nx ny apice cy
  cols=$(tput cols 2>/dev/null || echo 80)
  rows=$(tput lines 2>/dev/null || echo 24)
  cols=$((cols > 30 ? cols : 80))
  rows=$((rows > 8 ? rows : 20))
  cy=$((rows / 2 - 2)); [ "$cy" -lt 2 ] && cy=2

  # FASE 1: lancio del razzo con scia + esplosione in raggiera, frame pulito
  # (ogni esplosione viene cancellata prima della successiva).
  for f in $(seq 1 6); do
    x=$((6 + RANDOM % (cols - 14)))
    apice=$((2 + RANDOM % 5))
    # lancio: cancella la scia dietro, poi disegna la testa
    for r in $(seq $rows -1 $apice); do
      printf '\033[%d;%dH\033[0m \033[0m' "$((r + 1))" "$x"
      printf '\033[%d;%dH\033[1;3%dm*\033[0m' "$r" "$x" "$((1 + RANDOM % 6))"
      sleep 0.008
    done
    # esplosione: raggi anulari + nucleo bianco
    for i in 0 1 2 3 4 5 6 7; do
      dx=$(( (i % 4 == 0) ? 0 : (i % 3 == 0 ? 3 : 2) ))
      dy=$((i % 2 == 0 ? 2 : 1))
      nx=$(( x + (i < 4 ? dx : -dx) )); [ "$nx" -lt 1 ] && nx=1; [ "$nx" -gt $((cols - 1)) ] && nx=$((cols - 1))
      ny=$(( apice - (i % 2 == 0 ? dy : -dy) )); [ "$ny" -lt 1 ] && ny=1
      printf '\033[%d;%dH\033[1;3%dm*\033[0m' "$ny" "$nx" "$((1 + RANDOM % 6))"
    done
    printf '\033[%d;%dH\033[1;37m*\033[0m' "$apice" "$x"
    sleep 0.12
    # pulisci esplosione e colonna prima del razzo successivo (nessun residuo)
    for i in 0 1 2 3 4 5 6 7; do
      dx=$(( (i % 4 == 0) ? 0 : (i % 3 == 0 ? 3 : 2) ))
      dy=$((i % 2 == 0 ? 2 : 1))
      nx=$(( x + (i < 4 ? dx : -dx) )); [ "$nx" -lt 1 ] && nx=1; [ "$nx" -gt $((cols - 1)) ] && nx=$((cols - 1))
      ny=$(( apice - (i % 2 == 0 ? dy : -dy) )); [ "$ny" -lt 1 ] && ny=1
      printf '\033[%d;%dH\033[0m \033[0m' "$ny" "$nx"
    done
    printf '\033[%d;%dH\033[0m \033[0m' "$apice" "$x"
    sleep 0.04
  done

  # FASE 2: pioggia di confetti breve (chiara e a bassa densita).
  for f in $(seq 1 8); do
    for ((x = 2; x <= cols - 1; x += 4)); do
      y=$((2 + RANDOM % (rows - 4)))
      printf '\033[%d;%dH\033[1;3%dm.\033[0m' "$y" "$x" "$((1 + RANDOM % 6))"
    done
    sleep 0.04
  done

  # FASE 3: banner finale (solo se tutti i lab sono completati).
  if all_labs_done; then
    n_labs="$(lab_ids | wc -l | tr -d ' ')"
    printf '\033[%d;1H\033[0m\033[1;33m    COMPLETATI %s/%s LABORATORI!    \033[0m' "$cy" "$n_labs" "$n_labs"
    sleep 0.5
  fi

  anim_leave
}

# Intro breve all'inizio della lezione (lab class): cornice con l'ID del lab e
# una barra di caricamento che si riempie progressivamente. Disegnata sul buffer
# alternato (nessun residuo) e inerte in non-TTY (la guardia [ -t 1 ] rende la
# chiamata un no-op in pipe/QA/suite). Durata complessiva ~1.2 s.
ascii_lesson() {
  [ -t 1 ] || return 0
  local lab="${1:-""}"
  local cols rows by bx bw tx i bar_w used
  cols=$(tput cols 2>/dev/null || echo 80)
  rows=$(tput lines 2>/dev/null || echo 24)
  cols=$((cols > 40 ? cols : 80))
  rows=$((rows > 10 ? rows : 20))

  anim_enter || return 0

  bw=$((cols - 4)); [ "$bw" -gt 52 ] && bw=52
  bx=$(((cols - bw) / 2)); [ "$bx" -lt 1 ] && bx=1
  by=3
  bar_w=$((bw - 4)); [ "$bar_w" -lt 10 ] && bar_w=10

  # Cornice (top/bottom una volta sola, da qui in poi ridisegno solo la barra).
  printf '\033[%d;%dH\033[33m%s%s%s\033[0m' "$by" "$bx" "$BX_TL" "$(printf '%*s' "$((bw - 2))" "" | tr ' ' "$BX_HB")" "$BX_TR"
  printf '\033[%d;%dH\033[33m%s%s%s\033[0m' "$((by + 4))" "$bx" "$BX_BL" "$(printf '%*s' "$((bw - 2))" "" | tr ' ' "$BX_HB")" "$BX_BR"
  for i in 1 2 3; do
    printf '\033[%d;%dH\033[33m%s\033[0m' "$((by + i))" "$bx" "$BX_VB"
    printf '\033[%d;%dH\033[33m%s\033[0m' "$((by + i))" "$((bx + bw - 1))" "$BX_VB"
  done

  # Titolo (centrato) e ID lab (grassetto, evidenziato).
  tx=$((bx + (bw - 7) / 2))
  printf '\033[%d;%dH\033[33mLEZIONE\033[0m' "$((by + 1))" "$tx"
  printf '\033[%d;%dH\033[1;37m%s\033[0m' "$((by + 2))" "$((bx + 2))" "$lab"

  # Barra di avanzamento: cresce da sinistra, ogni frame pulita prima di ridisegnare.
  for i in $(seq 0 20); do
    used=$((bar_w * i / 20))
    printf '\033[%d;%dH\033[0m[%s%s]%3d%%\033[0m' "$((by + 3))" "$((bx + 2))" \
      "$(printf '%*s' "$used" "" | tr ' ' '#')" \
      "$(printf '%*s' "$((bar_w - used))" "" | tr ' ' ' ')" \
      "$((i * 5))"
    sleep 0.06
  done

  anim_leave
}

# Razzo ASCII in decollo: esempio di animazione "a frame incorporati" (Workflow B
# della skill ascii-anim). Il razzo e' statico (in questo caso scritto a mano,
# ma puo' provenire da una conversione chafa/img2txt di un asset); a moversi e'
# la sua posizione sullo schermo. Ogni frame viene ripulito prima di ridisegnare,
# con scia in dissolvenza sotto il razzo. ~1.5 s totali, TTY-only.
ascii_rocket() {
  [ -t 1 ] || return 0
  local cols rows y x i clear_rows
  cols=$(tput cols 2>/dev/null || echo 80)
  rows=$(tput lines 2>/dev/null || echo 24)
  cols=$((cols > 40 ? cols : 80))
  rows=$((rows > 12 ? rows : 20))

  # Frame statici del razzo (righe del corpo, centrate in colonna 3; la colonna
  # di lancio x viene calcolata a runtime). Colori: corpo ciano, apertura rossa.
  local f1=$'\033[1;36m   /\\   \033[0m'
  local f2=$'\033[1;36m  /  \\  \033[0m'
  local f3=$'\033[1;36m |    | \033[0m'
  local f4=$'\033[1;37m|_/\\_|\033[0m'
  local f5=$'\033[1;31m|_/\\_|\033[0m'
  local f6=$'\033[1;33m|_/\\_|\033[0m'

  anim_enter || return 0

  for i in $(seq 0 8); do
    y=$((rows - 6 - (i * (rows - 10) / 8)))
    x=$((cols / 2 - 3)); [ "$x" -lt 1 ] && x=1

    # Pulisci l'area del frame precedente (corpo 6 righe + scia), dall'alto.
    for r in $(seq 0 9); do
      local cy=$((y + r))
      [ "$cy" -lt 1 ] && continue
      [ "$cy" -gt "$rows" ] && continue
      printf '\033[%d;%dH\033[0m       \033[0m' "$cy" "$x"
    done

    # Scia in dissolvenza sotto il razzo ('.' e '~', piu chiara ai lati).
    local s=""
    case $((i % 3)) in
      0) s='~';;
      1) s='.';;
      2) s=':';;
    esac
    for r in 1 2 3; do
      local sy=$((y + 5 + r))
      [ "$sy" -ge 1 ] && [ "$sy" -le "$rows" ] && \
        printf '\033[%d;%dH\033[0;36m%s%s%s\033[0m' "$sy" "$x" '.' "$s" '.'
    done

    # Corpo del razzo.
    printf '\033[%d;%dH%s\n' "$y" "$x" "$f1"
    printf '\033[%d;%dH%s\n' "$((y + 1))" "$x" "$f2"
    printf '\033[%d;%dH%s\n' "$((y + 2))" "$x" "$f3"
    printf '\033[%d;%dH%s\n' "$((y + 3))" "$x" "$f4"
    printf '\033[%d;%dH%s\n' "$((y + 4))" "$x" "$f5"
    printf '\033[%d;%dH%s\n' "$((y + 5))" "$x" "$f6"
    sleep 0.09
  done

  # Esplosione finale in stella (pulisce l'area, nessun residuo).
  local ey=$((rows - 8)); [ "$ey" -lt 2 ] && ey=2
  for i in 0 1 2 3 4 5 6 7; do
    for r in 0 1 2; do
      local rx=$(( cols / 2 - 2 + (i % 5) - 2 + r * (i / 2) ))
      local ry=$(( ey + (i % 3) - 1 ))
      [ "$rx" -ge 1 ] && [ "$rx" -le "$cols" ] && [ "$ry" -ge 1 ] && [ "$ry" -le "$rows" ] && \
        printf '\033[%d;%dH\033[1;3%dm*\033[0m' "$ry" "$rx" "$((1 + i % 6))"
    done
    sleep 0.05
  done
  for i in $(seq 0 7); do
    printf '\033[%d;%dH\033[0m \033[0m' "$((ey + (i % 3) - 1))" "$(( cols / 2 - 2 + (i % 5) - 2 + 0 * (i / 2) ))"
  done

  anim_leave
}

# Completamento di TUTTI i lab: fuochi d'artificio + messaggio + reset su conferma.
# Solo in modalita STANDARD (arcade ha il suo Game Over, hardcade e bloccato).
congrats_all_done() {
  is_standard || return 0
  all_labs_done || return 0
  [ -f "$NORMAL_STATE_DIR/congrats-shown" ] && return 0
  echo 1 > "$NORMAL_STATE_DIR/congrats-shown"
  # Isoliamo da set -e/pipefail: in questo blocco interattivo un comando
  # che "fallisce" non deve terminare lo script nel mezzo dell anteprima.
  (
    set +e
    ascii_fireworks
    hdr "COMPLIMENTI!"
    printf '  Hai completato tutti i %s laboratori!\n' "$(lab_ids | wc -l | tr -d ' ')"
    printf '\n'
    printf '  Queste sono le basi per il decollo.\n'
    printf '  Volare e atterrare richiedera impegno.\n'
    printf '\n'
    printf '  Vuoi ripartire da zero e ripetere l allenamento?\n'
    printf '  [s/N] (s = si, reset di tutti i lab; invio = continua) > '
    read -r risp || risp=""
    case "${risp:-}" in
      s|S|si|sì|Si|SI|y|Y|yes|YES)
        hdr "RESET  TUTTI I LAB"
        for id in $(lab_ids); do
          bash "$LABS/$id/reset.sh" >/dev/null 2>&1 || true
          rm -f "$STATE_DIR/done-$id" "$STATE_DIR/hint-$id" "$STATE_DIR/lives-$id" \
                "$NORMAL_STATE_DIR/hint-uses-$id" "$NORMAL_STATE_DIR/fail-$id"
        done
        rm -f "$ARCADE_PERFECT_FILE" "$NORMAL_STATE_DIR/congrats-shown"
        ok "tutti i lab azzerati — buon nuovo allenamento!"
        printf '\n'
        ;;
      *)
        printf 'Nessun reset effettuato. Puoi ricominciare quando vuoi con: lab reset --all\n\n'
        ;;
    esac
  )
}

hardcade_refuse() {
  hr
  printf '%s\n' '========================================'
  printf '  La modalita HARDCADE e una sfida segreta.\n'
  printf '  Si rivela solo a chi completa TUTTI i lab in modalita\n'
  printf '  ARCADE senza mai perdere un cuore (run perfetta).\n'
  printf '%s\n' '========================================'
  printf '\n'
  printf 'Hai gia sbloccato? Controlla:  lab status   e   lab mode\n\n'
  exit 2
}

cmd_mode() {
  ensure_state
  if is_hardcade; then
    if [ "${1:-}" = "standard" ] && [ "${2:-}" = "--exit" ]; then
      rm -f "$HARDCADE_STATE_DIR/active" "$HARDCADE_STATE_DIR/errors" \
            "$HARDCADE_STATE_DIR/help-used-"*
      rmdir "$HARDCADE_STATE_DIR" 2>/dev/null || true
      # Torna al root di lavoro STANDARD (coerente coi processi successivi).
      TRAINING_ROOT="/workspace/training"
      export LAB_TRAINING_ROOT="$TRAINING_ROOT"
      ok "Uscita da HARDCADE: i progressi hardcade sono stati abbandonati."
      printf 'I tuoi lab STANDARD/ARCADE sono intatti. Riprendi con:  lab list\n\n'
      return 0
    fi
    ok "Modalita corrente: HARDCADE (3 errori condivisi per sessione)"
    printf 'Sessione bloccata: non e possibile cambiare modalita qui.\n'
    printf 'Per uscire da HARDCADE e tornare al corso:  lab mode standard --exit\n'
    printf '\n'
    printf 'Giocatore: %s\n' "$(id -un 2>/dev/null || printf '?')"
    printf 'Errori rimasti: %s\n\n' "$(render_hardcade_errors)"
    return 0
  fi
  if [ "$#" -eq 0 ]; then
    if is_arcade; then
      ok "Modalita corrente: ARCADE (3 vite ❤️ ❤️ ❤️ con Game Over abilitato)"
    else
      ok "Modalita corrente: STANDARD (tentativi infiniti, niente vite perse, apprendimento sereno)"
    fi
    printf 'Per cambiare modalita:\n'
    printf '  lab mode standard   # -s   modalita standard (consigliata per novizi)\n'
    printf '  lab mode arcade     # -a   modalita arcade (sfida a 3 vite con cuori)\n\n'
    printf '  lab mode hardcade   # -hc  sfida segreta: si sblocca con una run ARCADE\n'
    printf '                      # perfetta (tutti i lab, 0 cuori persi)\n\n'
    printf '  lab mode class      # lezioni narrate di tutti i lab (01 → 10)\n'
    return 0
  fi
  case "${1:-}" in
    class|lessons|lezioni|--class)
      shift || true
      cmd_classes "$@"
      ;;
    standard|std|classic|relax|-s|--standard)
      echo "standard" > "$STATE_DIR/mode"
      ok "Modalita impostata su STANDARD (tentativi illimitati, niente vite perse)"
      printf 'Ora puoi lavorare con la massima tranquillita!\n\n'
      ;;
    arcade|lives|hardcore|-a|--arcade)
      echo "arcade" > "$STATE_DIR/mode"
      # Avvia la "run perfetta": 1 finche non perdi una vita (resta 0 se gia persa).
      if [ ! -f "$ARCADE_PERFECT_FILE" ]; then
        set_arcade_perfect 1
      fi
      ok "Modalita impostata su ARCADE (3 vite ❤️ ❤️ ❤️ con Game Over abilitato)"
      printf 'Buona sfida!\n\n'
      ;; 
hardcade|-hc|--hardcade)
      # Easter egg: sbloccato solo con run ARCADE perfetta.
      # Bypass esplicito: env LAB_EH_UNLOCK=1  oppure  lab mode hardcade --force
      if ! arcade_easter_unlocked &&
         [ "${LAB_EH_UNLOCK:-}" != "1" ] &&
         [ "${2:-}" != "--force" ]; then
        hardcade_refuse
      fi
      ascii_rain
      mkdir -p "$HARDCADE_STATE_DIR"
      echo 1 > "$HARDCADE_STATE_DIR/active"
      echo 0 > "$HARDCADE_STATE_DIR/errors"
      rm -f "$HARDCADE_STATE_DIR/done-"* "$HARDCADE_STATE_DIR/hint-"* "$HARDCADE_STATE_DIR/lives-"* \
            "$HARDCADE_STATE_DIR/variant-"* "$HARDCADE_STATE_DIR/order" "$HARDCADE_STATE_DIR/pos"
      STATE_DIR="$HARDCADE_STATE_DIR"
      # Root di lavoro separato per la run HARDCADE: i processi successivi
      # (es. lab check) lo rilevano dall'active file; deve essere coerente
      # anche per QUESTO processo (primo reset della run).
      TRAINING_ROOT="/workspace/hardcade-training"
      export LAB_TRAINING_ROOT="$TRAINING_ROOT"
      ok "Modalita HARDCADE attivata (3 errori condivisi per sessione)"
      printf 'Salvataggio separato: %s\n' "$HARDCADE_STATE_DIR"
      printf 'La modalita e irreversibile per questa sessione.\n'
      printf 'Parte subito un esercizio di un lab con una VARIANTE diversa\n'
      printf '(percorsi, file, utenti, pid, stringhe) e ordine dei lab casuale.\n\n'
      hc_enter
      ;;
    *)
      die "modalita non riconosciuta: $1 (usa 'standard', 'arcade' o 'hardcade')"
      ;;
  esac
}

render_lives() {
  local count="$1"
  local max="${2:-$MAX_LIVES}"
  local compact="${3:-0}"
  local str=""
  for ((i=1; i<=max; i++)); do
    if [ "$i" -le "$count" ]; then
      str="${str}❤️ "
    else
      str="${str}🖤 "
    fi
  done
  if [ "$compact" = "1" ]; then
    printf '%s' "$str"
  else
    printf '%s [%d/%d]' "$str" "$count" "$max"
  fi
}

# Numero di hint disponibili in ARCADE: lampadine fixe (3).
MAX_HINTS=3
HINT_STATE_DIR="${NORMAL_STATE_DIR:-/workspace/training/.lab-state}"

get_hints() {
  local id="$1"
  local hf="$HINT_STATE_DIR/hints-$id"
  if [ -f "$hf" ]; then
    cat "$hf"
  else
    echo "$MAX_HINTS"
  fi
}

set_hints() {
  local id="$1"
  local val="$2"
  ensure_state
  echo "$val" > "$HINT_STATE_DIR/hints-$id"
}

# 3 lampadine: 💡 accesa = hint disponibile, ⚪ spenta = consumato.
render_hints() {
  local count="$1"
  local str=""
  for ((i=1; i<=MAX_HINTS; i++)); do
    if [ "$i" -le "$count" ]; then
      str="${str}💡 "
    else
      str="${str}⚪ "
    fi
  done
  printf '%s' "$str"
}

# Timer lab ARCADE: registra start + limite random 5-10 min (300-600s).
arcade_timer_start() {
  ensure_state
  local start
  start=$(date +%s)
  local limit=$((300 + RANDOM % 301))
  echo "$start" > "$STATE_DIR/timer-start-$LAB_ID"
  echo "$limit" > "$STATE_DIR/timer-limit-$LAB_ID"
}

# Secondi rimanenti; 0 = scaduto, -1 = nessun timer attivo.
arcade_timer_remaining() {
  local id="$1"
  local sf="$STATE_DIR/timer-start-$id"
  local lf="$STATE_DIR/timer-limit-$id"
  if [ ! -f "$sf" ] || [ ! -f "$lf" ]; then
    echo -1
    return
  fi
  local start limit now elapsed
  start=$(cat "$sf")
  limit=$(cat "$lf")
  now=$(date +%s)
  elapsed=$((now - start))
  local rem=$((limit - elapsed))
  [ "$rem" -lt 0 ] && rem=0
  echo "$rem"
}

# Render leggibile del tempo rimanente: mm:ss.
format_mmss() {
  local secs="$1"
  printf '%02d:%02d' $((secs / 60)) $((secs % 60))
}

# Render della colonna vite come celle a larghezza costante: render_lives
# restituisce sempre 14 celle di display, a prescindere dal numero di vite
# (cuori e cuori neri sono entrambi larghi 2). Aggiungiamo padding fisso in
# spazi per allineare la colonna del TEMA anche nei terminali a larghezza.
VITE_PAD_SPACES=3
lives_col() {
  printf '%s%*s' "$1" "$VITE_PAD_SPACES" ""
}

get_lives() {
  local id="$1"
  local lf="$STATE_DIR/lives-$id"
  if [ -f "$lf" ]; then
    cat "$lf"
  else
    echo "$MAX_LIVES"
  fi
}

set_lives() {
  local id="$1"
  local val="$2"
  ensure_state
  echo "$val" > "$STATE_DIR/lives-$id"
}

reset_lab() {
  local id="$1"
  safe_cwd
  bash "$LABS/$id/reset.sh" || die "reset fallito per $id"
  ensure_state
  if ! is_hardcade; then set_lives "$id" "$MAX_LIVES"; fi
  set_hints "$id" "$MAX_HINTS"
  rm -f "$STATE_DIR/hint-$id" "$STATE_DIR/done-$id" \
        "$STATE_DIR/timer-start-$id" "$STATE_DIR/timer-limit-$id" \
        "$NORMAL_STATE_DIR/hint-uses-$id" "$NORMAL_STATE_DIR/fail-$id" \
        "$HARDCADE_STATE_DIR/help-used-$id"
}

do_reset() {
  reset_lab "$LAB_ID"
  # Se l'utente era in una subdir del lab, riportalo su /workspace.
  # Messaggio in chiaro per un principiante: cwd = dove sei adesso.
  printf 'Sei adesso in: /workspace  (la tua cartella di lavoro corrente).\n'
  printf 'Per iniziare il lab appena avviato, entra nella sua cartella di lavoro: usa il comando  cd  indicato nella sezione AVVIO della consegna.\n'
}

mark_done() {
  ensure_state
  date -u +'%Y-%m-%dT%H:%M:%SZ' > "$STATE_DIR/done-$LAB_ID"
}

is_done() {
  [ -f "$STATE_DIR/done-$1" ]
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------
cmd_list() {
  hdr "LAB DISPONIBILI"
  local tw
  tw=$(theme_col_width)
  if is_hardcade; then
    printf "%-22s  %-6s  %-15s  %-${tw}s\n" "ID" "STATO" "ERRORI SESSIONE" "TEMA"
  elif is_arcade; then
    printf "%-22s  %-6s  %-16s  %-12s  %-${tw}s\n" "ID" "STATO" "VITE" "INDIZI" "TEMA"
  else
    printf "%-22s  %-6s  %-${tw}s\n" "ID" "STATO" "TEMA"
  fi
  hr
  local id mark theme lives hints
  for id in $(lab_ids); do
    if is_done "$id"; then
      mark="DONE"
    else
      mark="-"
    fi
    theme=$(cat "$LABS/$id/theme.txt" 2>/dev/null || printf '%s' "-")
    if is_hardcade; then
      printf "%-22s  %-6s  %s%s\n" "$id" "$mark" "$(lives_col "$(render_hardcade_errors)")" "$(theme_str "$theme")"
    elif is_arcade; then
      lives=$(get_lives "$id")
      hints=$(get_hints "$id")
      printf "%-22s  %-6s  %-16s  %-12s  %s\n" "$id" "$mark" "$(render_lives "$lives")" "$(render_hints "$hints") [$hints/$MAX_HINTS]" "$(theme_str "$theme")"
    else
      printf "%-22s  %-6s  %s\n" "$id" "$mark" "$(theme_str "$theme")"
    fi
  done
  printf '\nAvvia:  lab start <id>\n'
  printf 'Stato:  lab status\n\n'
}

# Al primo `lab start` in modalita STANDARD ricorda l'uso di man/--help.
maybe_remind_man() {
  is_standard || return 0
  local flag="$NORMAL_STATE_DIR/man-reminder-shown"
  [ -f "$flag" ] && return 0
  echo 1 > "$flag"
  hdr "SUGGERIMENTO: man e --help"
  printf 'Ogni comando Linux ha una guida integrata:\n'
  printf '  %s    %s\n' "$(cmd '<comando> --help')" "# sintesi rapida delle opzioni"
  printf '  %s       %s\n' "$(cmd 'man <comando>')" "# manuale completo (es. man cp)"
  printf '\nEsempi:  %s   ·   %s   ·   %s\n' "$(cmd 'ls --help')" "$(cmd 'man mkdir')" "$(cmd 'man mv')"
  printf 'Esplora le opzioni da solo prima di chiedere un indizio!\n\n'
}

cmd_start() {
  require_lab "$@"
  hdr "START  $LAB_ID"
  if is_arcade || is_hardcade; then
    # Salvaguardia: dove il timer gira (start) la battitura e' istantanea.
    export LAB_INSTANT_RENDER=1
  fi
  printf 'Reset in corso...\n'
  do_reset
  printf '\n'
  hr
  ok "lab $LAB_ID pronto"
  if is_hardcade; then
    printf 'Errori iniziali/sessione: %s\n' "$(render_hardcade_errors)"
  elif is_arcade; then
    arcade_timer_start
    printf 'Vite iniziali: %s\n' "$(render_lives "$MAX_LIVES")"
    printf 'Indizi:        %s\n' "$(render_hints "$MAX_HINTS") [${MAX_HINTS}/${MAX_HINTS}]"
    printf 'Timer:         ⏳ %s  (limite sfida)\n' "$(format_mmss "$(arcade_timer_remaining "$LAB_ID")")"
  fi
  printf '\n'
  print_task
  maybe_remind_man
}

cmd_task() {
  require_lab "$@"
  print_task
}

# Feedback didattico per la modalita STANDARD: estrae dai controlli falliti
# il comando correttivo (X) e il comando di verifica (Y), al posto del
# semplice footer generico. Non tocca la resa di ARCADE/HARDCADE.
didactic_feedback() {
  local check_out="$1" line cmds=() veri=() i c
  while IFS= read -r line; do
    case "$line" in
      '        -> verifica: '*)
        veri+=("${line#*'-> verifica: '}")
        ;;
      '        -> '*)
        cmds+=("${line#*'-> '}")
        ;;
    esac
  done <<< "$check_out"
  local cc=${#cmds[@]}
  printf '  ATTENZIONE: non tutti i controlli sono passati.\n' | typewrite
  printf '  Ecco come correggere gli errori rilevati:\n' | typewrite
  printf '\n'
  if [ "$cc" -gt 0 ]; then
    for ((i = 0; i < cc; i++)); do
      c="${cmds[i]}"
      printf '    • %s\n' "$c" | typewrite -c
      if [ "${#veri[@]}" -gt "$i" ]; then
        printf '      per verificare: %s\n' "${veri[i]}" | typewrite -c
      fi
    done
  else
    printf '    (riprendi le consegne con: lab task %s)\n' "$LAB_ID" | typewrite
  fi
  printf '\n'
  printf 'Poi rilancia il controllo con:  lab check %s\n\n' "$LAB_ID" | typewrite -c
}

cmd_check() {
  require_lab "$@"

  # F2: in HARDCADE la verifica e ammessa SOLO sul lab corrente della run
  # (il prossimo non completato nell'ordine). Un check sul lab sbagliato
  # avrebbe valutato valori BASE e consumato errore senza motivo.
  if is_hardcade; then
    local hc_current
    hc_current=$(hc_next 2>/dev/null || true)
    if [ -z "$hc_current" ]; then
      die "run HARDCADE completata: nessun lab rimasto da verificare."
    fi
    if [ "$LAB_ID" != "$hc_current" ]; then
      die "in HARDCADE puoi verificare solo il lab corrente: $hc_current (non $LAB_ID). Nessun errore consumato."
    fi
  fi

  safe_cwd
  hdr "CHECK  $LAB_ID"

  if is_hardcade; then
    local current_errors
    current_errors=$(hardcade_errors)
    if [ "$current_errors" -ge 3 ]; then hardcade_game_over; fi
  fi
  
  if is_arcade; then
    local current_lives timer_penalty_applied=0
    current_lives=$(get_lives "$LAB_ID")
    if [ "$current_lives" -le 0 ]; then
      warn "Hai esaurito tutte le vite per il lab $LAB_ID."
      printf 'Vite attuali: %s\n\n' "$(render_lives 0)"
      printf 'Per ripartire con 3 nuove vite (reset pulito):\n'
      printf '  lab start %s   (oppure: lab reset %s)\n\n' "$LAB_ID" "$LAB_ID"
      exit 1
    fi
    # Timer: se scaduto, -1 vita rossa (i file NON vengono cancellati).
    # Il marcatore timer-start viene CONSUMATO alla prima penalita: ogni lab check
    # successivo alla scadenza non deve togliere un'altra vita (finding #2).
    # Se la penalita timer e gia stata applicata in questa chiamata, un eventuale
    # fallimento del check NON somma un'ulteriore perdita di vita (alternativi, non cumulativi).
    local t_rem
    t_rem=$(arcade_timer_remaining "$LAB_ID")
    if [ "$t_rem" -eq 0 ] && [ -f "$STATE_DIR/timer-start-$LAB_ID" ]; then
      warn "TEMPO SCADUTO per $LAB_ID — hai perso 1 vita!"
      set_lives "$LAB_ID" $((current_lives - 1))
      current_lives=$((current_lives - 1))
      timer_penalty_applied=1
      set_arcade_perfect 0
      set_arcade_streak 0
      # Penalita applicata: consuma il timer cosi non toglie vite ai check successivi.
      rm -f "$STATE_DIR/timer-start-$LAB_ID"
      if [ "$current_lives" -le 0 ]; then
        printf 'Vite rimaste: %s\n\n' "$(render_lives 0)"
        printf 'Hai esaurito le vite per tempo scaduto: i file restano, rilancia:\n'
        printf '  lab start %s\n\n' "$LAB_ID"
        exit 1
      fi
      printf 'Vite rimaste: %s\n\n' "$(render_lives "$current_lives")"
    fi
  fi

  set +e
  local check_out check_passed check_total
  check_out=$(bash "$LAB/check.sh" 2>&1)
  local status=$?
  set -e
  printf '%s\n' "$check_out"
  check_passed=$(printf '%s\n' "$check_out" | grep -c '  PASS  ' || true)
  check_total=$(printf '%s\n' "$check_out" | grep -cE '  (PASS|FAIL)  ' || true)
  printf '\n'
  if [ "$check_total" -gt 0 ]; then
    printf '  Riepilogo: %s/%s controlli superati\n' "$check_passed" "$check_total"
    printf '\n'
  fi
  if [ "$status" -eq 0 ]; then
    mark_done
    ok "LAB COMPLETATO: $LAB_ID"
    local arcade_bonus=0
    if is_arcade; then
      # Streak: il lab appena completato senza fallimenti incrementa il conto.
      if [ ! -f "$NORMAL_STATE_DIR/fail-$LAB_ID" ]; then
        local streak
        streak=$(arcade_streak)
        streak=$((streak + 1))
        if [ "$streak" -ge 3 ]; then
          arcade_bonus=1
          current_lives=$((current_lives + 1))
          [ "$current_lives" -gt "$MAX_LIVES" ] && current_lives="$MAX_LIVES"
          set_lives "$LAB_ID" "$current_lives"
          set_arcade_streak 0
        else
          set_arcade_streak "$streak"
        fi
      else
        rm -f "$NORMAL_STATE_DIR/fail-$LAB_ID"
      fi
    fi
    if is_hardcade; then
      printf 'Errori rimasti: %s\n' "$(render_hardcade_errors)"
    elif is_arcade; then
      printf 'Vite finali: %s\n' "$(render_lives "$current_lives")"
      if [ "$arcade_bonus" -eq 1 ]; then
        printf '🌟 Streak 3 lab puliti: +1 vita!  %s\n' "$(arcade_streak_message)"
      fi
    fi
    if [ -f "$LAB/why.txt" ]; then
      hdr "PERCHE FUNZIONA"
      cat "$LAB/why.txt" | hc_render_text | typewrite
      printf '\n'
    fi
    printf 'Prossimo: lab list   oppure   lab start <altro-id>\n\n'
    congrats_all_done
    if is_hardcade; then
      hc_advance
    fi
  else
    if is_hardcade; then
      local used=$((current_errors + 1))
      echo "$used" > "$HARDCADE_STATE_DIR/errors"
      if [ "$used" -ge 3 ]; then
        warn "check FALLITO — terzo errore: HARDCADE GAME OVER"
        hardcade_game_over
      fi
      warn "check FALLITO — errore HARDCADE $used/3"
      printf 'Errori rimasti: %s\n' "$(render_hardcade_errors)"
      printf 'I tuoi file NON sono stati cancellati.\n\n'
      exit "$status"
    fi
    if is_arcade; then
      # Se in questa chiamata il timer era gia scaduto (penalita applicata sopra),
      # il fallimento del check NON toglie un'altra vita: sono alternative, non
      # cumulabili nella stessa invocazione (finding #2).
      local remaining
      if [ "$timer_penalty_applied" -eq 0 ]; then
        remaining=$((current_lives - 1))
      else
        remaining="$current_lives"
      fi
      set_lives "$LAB_ID" "$remaining"
      set_arcade_perfect 0   # una vita persa: niente run perfetta -> hardcade resta bloccato
      set_arcade_streak 0    # un check fallito spezza la streak di lab puliti
      ensure_state
      echo 1 > "$NORMAL_STATE_DIR/fail-$LAB_ID"
      if [ "$remaining" -gt 0 ]; then
        if [ "$timer_penalty_applied" -eq 1 ]; then
          warn "check FALLITO (vita gia persa per tempo scaduto)"
        else
          warn "check FALLITO — hai perso 1 vita!"
        fi
        printf 'Vite rimaste: %s\n\n' "$(render_lives "$remaining")"
        printf 'I tuoi file NON sono stati cancellati. Correggi l errore e riprova:\n'
        printf '  lab hint  %s      # indizio (progressivo)\n' "$LAB_ID"
        printf '  lab task  %s      # rivedi la consegna\n' "$LAB_ID"
        printf '  lab check %s      # riprova dopo le correzioni\n' "$LAB_ID"
        printf '  lab reset %s      # SOLO se vuoi ripartire da zero\n' "$LAB_ID"
        printf '\n'
      else
        warn "Hai perso l'ultima vita per questo lab."
        printf 'Vite rimaste: %s\n\n' "$(render_lives 0)"
        printf 'Cosa fare adesso:\n'
        printf '  Hai esaurito le 3 vite. Per riprovare con 3 nuove vite:\n'
        printf '    lab start %s\n' "$LAB_ID"
        printf '  ATTENZIONE: start/reset azzerano anche il lavoro gia fatto\n'
        printf '  correttamente in questo lab. Se vuoi salvare qualcosa,\n'
        printf '  copialo prima in /workspace prima di rilanciare.\n'
        printf '  Per consultare la soluzione di riferimento:\n'
        printf '    lab solution %s\n' "$LAB_ID"
        printf '\n'
      fi
    else
      warn "check FALLITO — i tuoi file NON sono stati cancellati"
      printf '\n'
      didactic_feedback "$check_out"
      printf '(Indizi progressivi:  lab hint %s   ·   Rivedi la consegna:  lab task %s)\n' "$LAB_ID" "$LAB_ID"
    fi
    exit "$status"
  fi
}

get_hint_count() {
  local file="$1"
  if grep -q '^---$' "$file" 2>/dev/null; then
    awk 'BEGIN{c=1} /^---$/{c++} END{print c}' "$file"
  else
    grep -c . "$file" || echo 0
  fi
}

print_hint_block() {
  local file="$1"
  local index="$2"
  if grep -q '^---$' "$file" 2>/dev/null; then
    awk -v target="$index" '
      BEGIN { c=1; content="" }
      /^---$/ {
        if (c == target) {
          gsub(/^\n+|\n+$/, "", content);
          print content;
          found=1;
          exit;
        }
        c++;
        content="";
        next;
      }
      {
        if (content == "") content = $0;
        else content = content "\n" $0;
      }
      END {
        if (!found && c == target) {
          gsub(/^\n+|\n+$/, "", content);
          print content;
        }
      }
    ' "$file" | hc_render_text | typewrite
  else
    sed -n "${index}p" "$file" | hc_render_text | typewrite
  fi
}

print_all_hints() {
  local file="$1"
  if grep -q '^---$' "$file" 2>/dev/null; then
    awk '
      BEGIN { c=1; content="" }
      /^---$/ {
        gsub(/^\n+|\n+$/, "", content);
        printf "\n--- [HINT %d] ----------------------------------\n%s\n", c, content;
        c++;
        content="";
        next;
      }
      {
        if (content == "") content = $0;
        else content = content "\n" $0;
      }
      END {
        gsub(/^\n+|\n+$/, "", content);
        printf "\n--- [HINT %d] ----------------------------------\n%s\n", c, content;
      }
    ' "$file" | hc_render_text | typewrite
  else
    nl -ba "$file" | hc_render_text | typewrite
  fi
}

cmd_hint() {
  # `lab -h` / `lab hint` senza id: usa il lab corrente (l'ultimo toccato).
  if [ "$#" -eq 0 ] || [ -z "${1:-}" ]; then
    local cur
    cur=$(cat "$STATE_DIR/current-lab" 2>/dev/null || true)
    if [ -z "$cur" ]; then
      hdr "HINT"
      printf 'Indica il lab:  lab hint <id>     (oppure prima:  lab start <id>)\n'
      printf 'Oppure, se sai gia l id:  lab hint 02-permissions\n\n'
      return 1
    fi
    set -- "$cur"
  fi
  require_lab "$@"

  # F2: stessa guardia di cmd_check — in HARDCADE l'aiuto e ammesso solo
  # sul lab corrente della run, per non sprecare errori su un lab sbagliato.
  if is_hardcade; then
    local hc_current
    hc_current=$(hc_next 2>/dev/null || true)
    if [ -z "$hc_current" ]; then
      die "run HARDCADE completata: nessun lab rimasto da aiutare."
    fi
    if [ "$LAB_ID" != "$hc_current" ]; then
      die "in HARDCADE puoi chiedere aiuto solo per il lab corrente: $hc_current (non $LAB_ID). Nessun errore consumato."
    fi
  fi

  shift || true
  local mode="next"
  case "${1:-}" in
    --all)   mode="all" ;;
    --reset) mode="reset" ;;
    "")      mode="next" ;;
    *)       die "opzione hint sconosciuta: $1 (usa --all o --reset)" ;;
  esac

  local hf="$LAB/hint.txt"
  [ -f "$hf" ] || die "nessun hint per $LAB_ID"
  ensure_state
  local sf="$STATE_DIR/hint-$LAB_ID"
  local total
  total=$(get_hint_count "$hf")
  [ "$total" -gt 0 ] || die "hint.txt vuoto"

  if [ "$mode" = "reset" ]; then
    rm -f "$sf"
    ok "indizi azzerati per $LAB_ID"
    printf 'Rilancia: lab hint %s\n' "$LAB_ID"
    return 0
  fi

  # HARDCADE: la consultazione di un indizio consuma l'aiuto del lab (OTK).
  if is_hardcade && ! hardcade_use_help; then
    return 0
  fi
  if is_arcade || is_hardcade; then
    # Salvaguardia: in arcade gli hint costano cuori/lampadine -> battitura istantanea.
    export LAB_INSTANT_RENDER=1
  fi
  local help_shown=0

  # HARDCADE: il prezzo (1 dei 3 errori condivisi per l'intera sessione) e alto:
  # una volta pagato, la cascata completa degli indizi viene mostrata subito,
  # non solo il primo livello concettuale (finding #4). Coerente con cmd_solution
  # che in HARDCADE mostra gia tutta la soluzione.
  if is_hardcade; then
    mode="all"
  fi

  if [ "$mode" = "all" ]; then
    # In ARCADE il "all" e sconsigliato: consumerebbe solo concetto ma conta 1 lampadina.
    if is_arcade; then
      hdr "HINT  $LAB_ID"
      printf 'In modalita ARCADE gli indizi sono limitati (3 lampadine) e oscurati.\n'
      printf 'Usa:  lab hint %s     (concede 1 indizio, 1 lampadina)\n\n' "$LAB_ID"
      return 0
    fi
    hdr "HINT  $LAB_ID  (tutti - $total disponibili)"
    print_all_hints "$hf"
    printf '\n'
    help_shown=1
  else
    # ARCADE: ogni hint consuma 1 lampadina (max 3) e rivela l'indizio
    # successivo (dal concetto verso il comando), non quello ripetuto.
    if is_arcade; then
      local hints_left
      hints_left=$(get_hints "$LAB_ID")
      if [ "$hints_left" -le 0 ]; then
        hdr "HINT  $LAB_ID"
        printf 'Hai esaurito i 3 indizi (lampadine) per questo lab.\n'
        printf 'Risolvi senza aiuto o ricomincia: lab reset %s\n\n' "$LAB_ID"
        return 0
      fi
      set_hints "$LAB_ID" $((hints_left - 1))
      local n=0
      [ -f "$sf" ] && n=$(cat "$sf")
      n=$((n + 1))
      [ "$n" -gt "$total" ] && n="$total"
      echo "$n" > "$sf"
      hdr "HINT  $LAB_ID  (lampadine: $(render_hints $((hints_left - 1))))"
      print_hint_block "$hf" "$n"
      printf '\n'
      printf 'Lampadine rimaste: %s\n' "$(render_hints $((hints_left - 1)))"
      if [ "$n" -lt "$total" ]; then
        printf 'Prossimo indizio: lab hint %s\n\n' "$LAB_ID"
      else
        printf 'Ultimo indizio visualizzato.\n\n'
      fi
      help_shown=1
    else
    local n=0
    [ -f "$sf" ] && n=$(cat "$sf")
    n=$((n + 1))
    if [ "$n" -gt "$total" ]; then
      hdr "HINT  $LAB_ID"
      printf 'Hai gia visualizzato tutti gli indizi disponibili (%s/%s).\n' "$total" "$total"
      printf '  lab hint %s --all     # rivedili tutti insieme\n' "$LAB_ID"
      printf '  lab hint %s --reset   # riparti dal primo indizio\n' "$LAB_ID"
      printf '  lab solution %s       # consulta la soluzione di riferimento\n' "$LAB_ID"
      printf '\n'
      return 0
    fi
    echo "$n" > "$sf"
    hdr "HINT  $LAB_ID  ($n/$total)"
    print_hint_block "$hf" "$n"
    printf '\n'
    if [ "$n" -lt "$total" ]; then
      printf 'Prossimo indizio: lab hint %s\n\n' "$LAB_ID"
    else
      printf 'Questo era l ultimo indizio. Se ti serve ulteriore aiuto: lab solution %s\n\n' "$LAB_ID"
    fi
    help_shown=1
    fi
  fi

  # ARCADE: gli indizi non sono piu gratuiti — consumano vite in modo crescente
  # (1° gratis, poi +1 vita a ciascun uso fino a esaurire le lampadine).
  if is_arcade && [ "$help_shown" -eq 1 ]; then
    local used lives
    used=$((MAX_HINTS - $(get_hints "$LAB_ID")))
    if [ "$used" -ge 2 ]; then
      lives=$(get_lives "$LAB_ID")
      if [ "$lives" -gt 0 ]; then
        lives=$((lives - 1))
        set_lives "$LAB_ID" "$lives"
        warn "gli indizi ora costano vite: -1 vita (ne restano $lives)"
        set_arcade_perfect 0
        printf 'Vite attuali: %s\n\n' "$(render_lives "$lives")"
      fi
    fi
  fi
}

# --- lab mode class: lezioni di TUTTI i lab, esposte nell'ordine dei lab ------
# Index 01→10; selezioni un lab e parte la narrazione dei suoi argomenti
# (flusso cmd_class). Non dipende dalla modalita corrente.
cmd_classes() {
  ensure_state
  hdr "LEZIONI  (lab mode class)"
  printf 'Tutte le lezioni, nell ordine dei lab (01 → 10).\n'
  printf 'Scegli un lab per ascoltare gli argomenti narrati.\n'
  printf '\n'
  local ids=() i=0 id theme na
  while IFS= read -r id; do
    ids+=("$id")
  done < <(lab_ids)
  local total=${#ids[@]}
  for (( i=0; i<total; i++ )); do
    id="${ids[$i]}"
    theme=$(cat "$LABS/$id/theme.txt" 2>/dev/null || printf '%s' "-")
    na=$(grep -c '^ARGOMENTO:' "$LABS/$id/class.txt" 2>/dev/null || printf '%s' "0")
    printf '  %s  %s%-28s%s  %s\n' "$(cmd "[$((i+1))]")" "$(bold "$id")" "" "" "$([ "$na" -gt 0 ] && printf '%s' "$theme · $na argomenti" || printf '%s' "$theme")"
  done
  printf '\n'
  printf '  [0] = esci, [invio] = esci\n'
  while true; do
    printf 'Scegli un lab [1-%s, 0 = esci] > ' "$total"
    local scelta
    read -r scelta || scelta="0"
    case "${scelta:-0}" in
      0|"") printf '\n'; return 0 ;;
      *[!0-9]*|0) printf '  Scelta non valida. Riprova.\n' ;;
      *)
        if [ "$scelta" -ge 1 ] 2>/dev/null && [ "$scelta" -le "$total" ]; then
          cmd_class "${ids[$((scelta-1))]}"
          printf '\n'
        else
          printf '  Scelta non valida. Riprova.\n'
        fi
        ;;
    esac
  done
}

# --- class: lezione narrata interattiva sugli argomenti di un lab -------------
# LAB_TYPE_CLASS (default 0.03) controlla la velocita' di battitura del testo.
#
# Formato del file class.txt:
#   ARGOMENTO: <nome>           (i nomi NON devono contenere virgole)
#   NARRAZIONE: <testo>         (puo' proseguire su piu' righe fino al tag
#   <altre righe>                successivo / riga vuota: vengono ricomposte
#   ...                          in un'unica frase con spazi)
#   RIASSUNTO: <testo>
#   (riga vuota tra un argomento e il successivo)
#
# Colori della lezione (regole colori corso):
#   titolo/header       cyan   (1;36)
#   domanda "Dubbi?"    giallo (1;33)  + argomento corrente menu verde (1;32)
#   riassunto           magenta (1;35)
cmd_class() {
  require_lab "$@"
  shift || true
  local class_file="$LAB/class.txt"
  [ -f "$class_file" ] || die "nessuna lezione per $LAB_ID (file class.txt mancante)"

  # Velocita' lezione (override via LAB_TYPE_CLASS)
  local saved_speed="${LAB_TYPE_NARR:-0.04}"
  LAB_TYPE_NARR="${LAB_TYPE_CLASS:-0.03}"

  # Parsing class.txt: estrae ARGOMENTO/NARRAZIONE/RIASSUNTO in array
  local names=() narrs=() riasss=()
  local in_section="" cur_name="" cur_narr="" cur_riass=""
  while IFS= read -r line; do
    case "$line" in
      "ARGOMENTO:"*)
        if [ -n "$cur_name" ]; then
          names+=("$cur_name"); narrs+=("$cur_narr"); riasss+=("$cur_riass")
        fi
        cur_name="${line#ARGOMENTO: }"; cur_narr=""; cur_riass=""; in_section="narr"
        ;;
      "NARRAZIONE:"*) in_section="narr"; cur_narr="${line#NARRAZIONE: }" ;;
      "RIASSUNTO:"*)  in_section="riass"; cur_riass="${line#RIASSUNTO: }" ;;
      "") in_section="" ;;
      *)
        case "$in_section" in
          narr) cur_narr="${cur_narr:+$cur_narr }${line}" ;;
          riass) cur_riass="${cur_riass:+$cur_riass }${line}" ;;
        esac ;;
    esac
  done < "$class_file"
  if [ -n "$cur_name" ]; then
    names+=("$cur_name"); narrs+=("$cur_narr"); riasss+=("$cur_riass")
  fi
  local total=${#names[@]}
  [ "$total" -gt 0 ] || die "class.txt vuoto per $LAB_ID"

  # Titolo
  hdr "LEZIONE: $LAB_ID"
  # Intro animata breve (inerte in non-TTY grazie alla guardia [ -t 1 ]).
  ascii_lesson "$LAB_ID"
  printf 'Argomenti: %s\n\n' "$(IFS=', '; echo "${names[*]}")"
  # Micro-guida per il principiante: durante la dettatura i soli tasti con
  # effetto sono INVIO e SPAZIO (completano subito la frase corrente); gli
  # altri tasti sono ignorati. Mostrata solo su terminale interattivo (in
  # non-TTY e' rumore inutile).
  if [ -t 0 ]; then
    printf '\033[33mPremi INVIO o SPAZIO per completare subito la frase (gli altri tasti sono ignorati).\033[0m\n'
    printf '\033[33mA ogni argomento: [0] continua · [1..%d] riassunto.\033[0m\n\n' "$total"
  fi

  # Per ogni argomento
  local i
  for (( i=0; i<total; i++ )); do
    printf '\n\033[33m--- ARGOMENTO %d/%d: %s ---\033[0m\n' \
      "$((i+1))" "$total" "${names[$i]}"
    # Testo narrato con battitura (voce del terminale/root: giallo opaco)
    printf '%s\n' "${narrs[$i]}" | LAB_TYPE_SPEAKER=Root typewrite
    printf '\n'

    # Menu interattivo "Ci sono dubbi?"
    while true; do
      printf '\033[33m  Ci sono dubbi?\033[0m\n'
      # Costruisce la riga singola del menu; se supera le 76 colonne visibili
      # (terminali 80-col, lab con molti argomenti) stampa le opzioni in colonna.
      # NOTA: la versione "visibile" (plain) viene costruita senza codici ANSI
      # per misurarne la larghezza reale: non usare sequenze letterali '\033'
      # nella stessa variabile o la misura fallisce.
      local j plain_buf="" colored_buf=""
      for (( j=0; j<total; j++ )); do
        if [ "$j" -eq "$i" ]; then
          colored_buf+="  \033[1;32m[$((j+1))] ${names[$j]}\033[0m"
        else
          colored_buf+="  [$((j+1))] ${names[$j]}"
        fi
        plain_buf+="  [$((j+1))] ${names[$j]}"
      done
      colored_buf+="  [0] Continua"
      plain_buf+="  [0] Continua"
      if [ "${#plain_buf}" -gt 76 ]; then
        for (( j=0; j<total; j++ )); do
          if [ "$j" -eq "$i" ]; then
            printf '  \033[1;32m[%d] %s\033[0m\n' "$((j+1))" "${names[$j]}"
          else
            printf '  [%d] %s\n' "$((j+1))" "${names[$j]}"
          fi
        done
        printf '  [0] Continua\n'
      else
        printf '%b\n' "$colored_buf"
      fi
      printf '  > '
      local choice
      if [ -t 0 ]; then
        IFS= read -r choice </dev/tty || choice="0"
      else
        choice="0"
      fi
      if [ "$choice" = "0" ] || [ -z "$choice" ]; then
        break
      elif [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ] 2>/dev/null; then
        local idx=$((choice-1))
        printf '\n\033[1;35m--- RIASSUNTO: %s ---\033[0m\n' "${names[$idx]}"
        printf '%s\n' "${riasss[$idx]}" | LAB_TYPE_SPEAKER=Root typewrite
        printf '\n'
      else
        printf '  Scelta non valida. Riprova.\n'
      fi
    done
  done

  # Ripristina velocita'
  LAB_TYPE_NARR="$saved_speed"

  # Messaggio finale
  hdr "COMPLIMENTI!"
  printf 'Ora conosci gli argomenti di %s.\n' "$LAB_ID"
  printf 'Prova:  \033[1;32mlab start %s\033[0m\n\n' "$LAB_ID"
}

cmd_solution() {
  require_lab "$@"
  # Modalita QA test (Lim): la soluzione deve restare introvabile durante un
  # test, altrimenti il check (che valida lo stato finale, non il processo)
  # produrrebbe falsi positivi. Nessuna soluzione, nessun marker: blocco secco.
  if [ "${LAB_QA_MODE:-0}" = "1" ]; then
    warn "LAB_QA_MODE attivo: soluzione bloccata (test Lim, niente falsi positivi)"
    printf 'Risolvi il lab con le tue conoscenze e gli hint; se ti blocchi,\n'
    printf 'segnalalo nel report come finding di qualita del corso.\n\n'
    return 1
  fi
  # HARDCADE: la soluzione e one-shot (OTK). Prima consultazione consuma l'aiuto
  # del lab e costa 1 errore; le successive sono bloccate.
  if is_hardcade && ! hardcade_use_help; then
    return 0
  fi
  hdr "SOLUTION  $LAB_ID"
  printf 'Leggi, non copiare a occhio chiuso.\n'
  # In HARDCADE la soluzione va letta con la variante attiva in testa:
  # i pattern tipo ${V_DIR:-...} nel testo corrispondono ai valori correnti.
  if is_hardcade; then
    printf 'Variante attiva: %s  ·  ' "$(bold "$(hc_variant "$LAB_ID")")"
    printf 'V_DIR=%s V_USER=%s\n' "${V_DIR:-}" "${V_USER:-}"
  fi
  hr
  grep -v '^lab check' "$LAB/solution.sh" || true
  printf '\n'
  hr
  printf 'Per applicarla (opzionale):\n'
  printf '  bash /opt/assisted-labs/labs/%s/solution.sh\n\n' "$LAB_ID"
}

cmd_reset() {
  if [ "${1:-}" = "--all" ] || [ "${1:-}" = "-a" ]; then
    hdr "RESET  TUTTI I LAB"
    local id
    for id in $(lab_ids); do
      reset_lab "$id"
      printf '  reset: %s\n' "$id"
    done
    # Nuova run: azzera il marcatore di run arcade perfetta.
    rm -f "$ARCADE_PERFECT_FILE"
    ok "tutti i lab azzerati"
    printf 'Avvia: lab list   oppure   lab start <id>\n\n'
    return 0
  fi
  require_lab "$@"
  hdr "RESET  $LAB_ID"
  do_reset
  ok "reset completato: $LAB_ID"
  printf 'Rivedi consegna: lab task %s\n\n' "$LAB_ID"
}

cmd_status() {
  ensure_state
  hdr "STATUS"
  local tw
  tw=$(theme_col_width)
  if is_hardcade; then
    printf "%-22s  %-6s  %-15s  %-${tw}s  %s\n" "ID" "STATO" "ERRORI SESSIONE" "TEMA" "COMPLETATO"
  elif is_arcade; then
    printf "%-18s %-6s %-10s %-10s %-${tw}s %s\n" "ID" "STATO" "VITE" "INDIZI" "TEMA" "COMPLETATO"
  else
    printf "%-22s  %-6s  %-${tw}s  %s\n" "ID" "STATO" "TEMA" "COMPLETATO"
  fi
  hr
  local id theme lives hints
  for id in $(lab_ids); do
    theme=$(cat "$LABS/$id/theme.txt" 2>/dev/null || printf '%s' "-")
    if is_hardcade; then
      if is_done "$id"; then
        printf "%-22s  %-6s  %s%-${tw}s  %s\n" "$id" "DONE" "$(lives_col "$(render_hardcade_errors)")" "$(theme_str "$theme")" "$(cat "$STATE_DIR/done-$id")"
      else
        printf "%-22s  %-6s  %s%-${tw}s  %s\n" "$id" "TODO" "$(lives_col "$(render_hardcade_errors)")" "$(theme_str "$theme")" "-"
      fi
    elif is_arcade; then
      lives=$(get_lives "$id")
      hints=$(get_hints "$id")
      if is_done "$id"; then
        printf "%-18s %-6s %-10s %-10s %-${tw}s %s\n" "$id" "DONE" "$(render_lives "$lives" "" 1)" "$(render_hints "$hints")" "$(theme_str "$theme")" "$(cat "$STATE_DIR/done-$id")"
      else
        printf "%-18s %-6s %-10s %-10s %-${tw}s %s\n" "$id" "TODO" "$(render_lives "$lives" "" 1)" "$(render_hints "$hints")" "$(theme_str "$theme")" "-"
      fi
    else
      if is_done "$id"; then
        printf "%-22s  %-6s  %-${tw}s  %s\n" "$id" "DONE" "$(theme_str "$theme")" "$(cat "$STATE_DIR/done-$id")"
      else
        printf "%-22s  %-6s  %-${tw}s  %s\n" "$id" "TODO" "$(theme_str "$theme")" "-"
      fi
    fi
  done
  printf '\nI file di lavoro: %s\n' "$TRAINING_ROOT"
  printf 'Stato interno:    %s\n\n' "$STATE_DIR"
}

cmd_doctor() {
  hdr "DOCTOR"
  printf 'host-container\n'
  printf '  user:      %s\n' "$(id -un 2>/dev/null || echo ?)"
  printf '  cwd:       %s\n' "$(pwd 2>/dev/null || echo 'INVALID (cd /workspace)')"
  printf '  lab bin:   %s\n' "$(command -v lab 2>/dev/null || echo MISSING)"
  printf '  lab root:  %s\n' "$ROOT"
  printf '  workspace: /workspace\n'
  printf '  training:  %s\n' "$TRAINING_ROOT"
  if is_hardcade; then
    printf '  modalita:  HARDCADE (errori condivisi: %s/3)\n' "$(hardcade_errors)"
  elif is_arcade; then
    printf '  modalita:  ARCADE (3 vite ❤️ ❤️ ❤️, indizi 💡💡💡, timer sfida)\n'
  else
    printf '  modalita:  STANDARD (rilassato)\n'
  fi
  printf '\n'

  printf 'lab installati in immagine (/opt/assisted-labs):\n'
  lab_ids | sed 's/^/  /'
  printf '\n'

  if [ -d /workspace/assisted-labs ]; then
    warn "trovata copia STALE su /workspace/assisted-labs"
    printf '  Il runtime usa SOLO /opt/assisted-labs (immagine).\n'
    printf '  La copia sul volume confonde e puo essere vecchia.\n'
    printf '  Rimuovila con:  rm -rf /workspace/assisted-labs\n'
    printf '  (i tuoi esercizi in /workspace/training restano intatti)\n\n'
  else
    ok "nessuna copia stale su /workspace/assisted-labs"
    printf '\n'
  fi

  local missing=0
  local t
  for t in bash ps top free nano less grep sed awk find stat sort uniq wc printf \
           mkdir cp mv rm chmod chown groupadd useradd usermod getent \
           pgrep sleep df du tar openrc logread logger ip ss ping curl ssh scp \
           rsync sudo crontab nc; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '  OK   %s\n' "$t"
    else
      printf '  MISS %s\n' "$t"
      missing=1
    fi
  done
  printf '\n'
  if [ "$missing" -eq 0 ]; then
    ok "tool base presenti"
  else
    warn "mancano tool — rebuild l'immagine"
  fi
  printf '\n'
  printf 'Volume: monta Alpine_Latest su /workspace\n'
  printf 'Avvio tipico (dall host):\n'
  printf '  docker run --rm -it -v Alpine_Latest:/workspace alpine-latest-assisted-labs:latest\n\n'
}

cmd_quit() {
  printf '\nChiusura della sessione Assisted Linux Labs...\n'
  kill -TERM "$PPID" 2>/dev/null || true
  exit 0
}

cmd_readme() {
  if [ -f "$ROOT/README.md" ]; then
    hdr "README"
    if [ -t 1 ] && command -v less >/dev/null 2>&1; then
      print_plain_md < "$ROOT/README.md" | less -R
    else
      print_plain_md < "$ROOT/README.md"
    fi
    printf '\n'
  else
    usage
  fi
}

# Anteprima delle animazioni senza doverle sbloccare. Utile per i costruttori.
#   lab anim fireworks   → fuochi d'artificio (completamento corso)
#   lab anim rain        → pioggia matrix pulita (intro hardcade)
#   lab anim all         → tutte in sequenza
cmd_anim() {
  local nome="${1:-all}"
  case "$nome" in
    fireworks|arti|fuochi) ascii_fireworks ;;
    rain|matrix|hardcade)  ascii_rain ;;
    lesson|lez|class)      ascii_lesson ;;
    rocket|razzo)          ascii_rocket ;;
    all|""|--all|-a)
      hdr "ANIM  lesson"
      ascii_lesson
      hdr "ANIM  rocket"
      ascii_rocket
      hdr "ANIM  fireworks"
      ascii_fireworks
      hdr "ANIM  rain"
      ascii_rain
      ;;
    *)
      die "animazione sconosciuta: $nome (usa lesson, rocket, fireworks, rain o all)"
      ;;
  esac
  printf '\n'
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in
  list)            shift; cmd_list "$@" ;;
  start)           shift; cmd_start "$@" ;;
  task|show|cat)   shift; cmd_task "$@" ;;
  check)           shift; cmd_check "$@" ;;
  hint|-h|--hint)    shift; cmd_hint "$@" ;;
  class)            shift; cmd_class "$@" ;;
  solution|sol)     shift; cmd_solution "$@" ;;
  reset)             shift; cmd_reset "$@" ;;
  status|stat)       shift; cmd_status "$@" ;;
  mode)              shift; cmd_mode "$@" ;;
  doctor|doc)        shift; cmd_doctor "$@" ;;
  quit|exit)         shift; cmd_quit "$@" ;;
  readme|guide)      shift; cmd_readme "$@" ;;
  anim|animazioni)   shift; cmd_anim "$@" ;;
  help|--help)       usage ;;
  version|--version) printf 'lab %s\n' "$VERSION" ;;
  "")
    welcome
    ;;
  *)
    warn "comando sconosciuto: ${1:-}"
    printf '\n'
    usage
    exit 2
    ;;
esac
